---

<div
  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-mono tracking-tight transition-all duration-200"
  style={{
    backgroundColor: config.badgeBg,
    borderColor: config.badgeBorder,
    borderWidth: '1px',
    borderStyle: 'solid',
    color: config.badgeText,
  }}
  title={`Primary language: ${config.label}`}
>
  <span
    class="w-1.5 h-1.5 rounded-full shrink-0"
    style={{ backgroundColor: config.dotColor }}
    aria-hidden="true"
  ></span>
  <span class="inline-flex shrink-0 opacity-80" set:html={config.iconSvg} aria-hidden="true" />
  <span class="font-medium text-slate-300">{config.label}</span>
</div>
