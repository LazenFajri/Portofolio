const config: LanguageConfig = (normalizedLang && languageMap[normalizedLang]) || {
  label: normalizedLang || 'Text / Config',
  dotColor: '#64748b',
  badgeBg: 'rgba(100, 116, 139, 0.08)',
  badgeBorder: 'rgba(100, 116, 139, 0.2)',
  badgeText: '#94a3b8',
