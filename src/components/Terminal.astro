<script type="module">
  import {
    bootSequence,
    skillsData,
    assetsData,
    linksData,
    foods,
    helpLines,
    getSkillDefs,
  } from '../lib/terminal-data.js';
  import {
    escapeHtml,
    lineDelayIndex,
    modeToggleLabels,
    nextMode,
    parseSpeed,
    pickRandom,
    resolveCommand,
    scrollTransform,
    shapeTransform,
    bounceVelocity,
    repel,
  } from '../lib/terminal-utils.js';
  import {
    appendAndScroll,
    createAssetGrid,
    createDivider,
    createEcho,
    createLine,
    createLinkGrid,
    createNote,
    createProfileGrid,
    createPrompt,
    createSkillBar,
  } from '../lib/terminal-dom.js';

  const getBody = () => document.getElementById('terminal-body');

  function runBootSequence() {
    const body = getBody();
    body.innerHTML = '';
    let idx = 0; let lineIndex = 0;
    function nextLine() {
      if (idx >= bootSequence.length) { addPrompt(); return; }
      const entry = bootSequence[idx]; idx++;
      if (entry.skip) { setTimeout(nextLine, entry.delay || 100); return; }
      appendAndScroll(body, createLine(entry.text, entry.cls, lineDelayIndex(lineIndex)));
      lineIndex++;
      setTimeout(nextLine, entry.delay || 300);
    }
    nextLine();
  }

  function addPrompt() {
    appendAndScroll(getBody(), createPrompt());
  }

  function outputLine(text, cls) {
    const lineEl = createLine(text, cls, 0);
    lineEl.style.animationDelay = '0ms';
    appendAndScroll(getBody(), lineEl);
  }

  function outputDivider() {
    appendAndScroll(getBody(), createDivider());
  }

  function clearOutput() {
    getBody().innerHTML = '';
    addPrompt();
  }

  function handleCommand(cmd) {
    appendAndScroll(getBody(), createEcho(escapeHtml(cmd)));

    switch (resolveCommand(cmd)) {
      case 'help': showHelp(); break;
      case 'skills': showSkills(); break;
      case 'assets': showAssets(); break;
      case 'links': showLinks(); break;
      case 'profile': showProfile(); break;
      case 'makan': showMakan(); break;
      case 'port': showPortStatus(); break;
      case 'clear': clearOutput(); return;
      default:
        outputLine('[ERROR] Unknown command: <span class="highlight-pink">' + escapeHtml(cmd) + '</span>', 'tag-warn');
        outputLine('<span class="dim">Available: [1] SKILLS, [2] ASSETS, [3] LINKS, [4] PROFILE, [help], [makan], [clear]</span>', 'dim');
    }
    addPrompt();
  }

  function showHelp() {
    outputLine('<span class="success">[OK]</span> Available commands:', 'tag-ok');
    for (const line of helpLines) { outputLine(line, ''); }
  }

  function showSkills() {
    outputLine(skillsData.title, skillsData.tag);
    outputDivider();
    for (const line of skillsData.lines) { outputLine(line); }

    const body = getBody();
    const isGui = document.getElementById('fajri-terminal').dataset.mode === 'gui';

    getSkillDefs(isGui).forEach((skill, i) => {
      setTimeout(() => {
        const { wrapper, fill } = createSkillBar(skill, isGui);
        appendAndScroll(body, wrapper);
        setTimeout(() => { fill.style.width = skill.pct + '%'; }, 100);
      }, i * 400);
    });
  }

  function showAssets() {
    outputLine(assetsData.title, assetsData.tag);
    outputDivider();
    for (const line of assetsData.lines) { outputLine(line); }

    const body = getBody();
    setTimeout(() => {
      appendAndScroll(body, createAssetGrid());
      setTimeout(() => {
        appendAndScroll(body, createNote('<span class="dim">💡 Files served from public/assets/ — inspect on GitHub: <a href="https://github.com/LazenFajri" class="highlight">github.com/LazenFajri</a></span>'));
      }, 200);
    }, 100);
  }

  function showLinks() {
    outputLine(linksData.title, linksData.tag);
    outputDivider();
    for (const line of linksData.lines) { outputLine(line); }

    const body = getBody();
    setTimeout(() => {
      appendAndScroll(body, createLinkGrid());
      setTimeout(() => {
        appendAndScroll(body, createNote('<span class="dim">🔗 <span class="makan">Check out my YouTube @fajriaep580 for After Effects work!</span></span>'));
      }, 200);
    }, 100);
  }

  function showProfile() {
    outputLine('<span class="highlight-purple">[04 // PROFILE]</span>', 'tag-prof');
    outputDivider();
    appendAndScroll(getBody(), createProfileGrid());
  }

  function showMakan() {
    outputLine('[MAKUAN AGENT] Fajri\'s current makan craving: <span class="makan">' + pickRandom(foods) + '</span>', 'tag-warn');
    outputLine('<span class="dim">Pro tip: Ask him about the best warung in <span class="highlight">Semarang</span> — he knows the spots.</span>', 'dim');
  }

  function showPortStatus() {
    outputLine('[PORT 4321] <span class="success">ACTIVE</span> // STATUS: 200 OK', 'tag-ok');
    outputLine('<span class="dim">Listening on: <span class="highlight">localhost:4321</span></span>', 'dim');
    outputLine('<span class="dim">TLS: <span class="success">ENABLED</span> | Engine: <span class="highlight-cyan">ASTRO</span> | Mode: <span class="highlight-purple">SERVER</span></span>', 'dim');
  }

  document.addEventListener('DOMContentLoaded', function() {
    runBootSequence();

    const input = document.getElementById('terminal-input');
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        const cmd = input.value;
        input.value = '';
        if (cmd.trim()) { handleCommand(cmd); }
      }
      if (e.key === 'Tab') { e.preventDefault(); input.value = 'help'; }
    });

    // Mode toggle (Terminal <-> Neubrutalist GUI)
    const modeToggle = document.getElementById('mode-toggle');
    const guiModeToggle = document.getElementById('gui-mode-toggle');
    const root = document.getElementById('fajri-terminal');
    
    function toggleMode() {
      const mode = nextMode(root.dataset.mode);
      root.dataset.mode = mode;
      if (modeToggle) {
        modeToggle.classList.toggle('active', mode === 'gui');
        const labels = modeToggleLabels(mode);
        const icon = modeToggle.querySelector('.mode-icon');
        const label = modeToggle.querySelector('.mode-label');
        if (icon) icon.textContent = labels.icon;
        if (label) label.textContent = labels.label;
      }
    }

    if (modeToggle) modeToggle.addEventListener('click', toggleMode);
    if (guiModeToggle) guiModeToggle.addEventListener('click', toggleMode);

    // Parallax Scroll & Mousemove Effects for GUI Mode
    const guiContainer = document.getElementById('neubrutalism-gui');
    if (guiContainer) {
      // 1. Mouse move 3D tilt effect on GUI Hero and Cards
      guiContainer.addEventListener('mousemove', function(e) {
        if (root.dataset.mode !== 'gui') return;
        const rect = guiContainer.getBoundingClientRect();
        const mouseX = e.clientX - rect.left - rect.width / 2;
        const mouseY = e.clientY - rect.top - rect.height / 2;

        document.querySelectorAll('.parallax-shape').forEach(shape => {
          const speed = parseSpeed(shape.getAttribute('data-speed'), 0.1);
          shape.style.transform = shapeTransform(mouseX, mouseY, speed);
        });
      });

      // 2. Scroll Parallax
      window.addEventListener('scroll', function() {
        if (root.dataset.mode !== 'gui') return;
        const scrolled = window.scrollY;
        document.querySelectorAll('#neubrutalism-gui [data-speed]').forEach(el => {
          const speed = parseSpeed(el.getAttribute('data-speed'), 0.05);
          el.style.transform = scrollTransform(scrolled, speed);
        });
      });
    }

    input.focus();
  });

  // --- p5.js Interactive Dual-Mode Canvas (Cyberpunk CLI & Neubrutalism GUI) ---
  if (typeof window !== 'undefined') {
    const initP5 = () => {
      if (!window.p5) return;
      new window.p5(p => {
        let particles = [];
        const particleCount = 40;

        p.setup = () => {
          const canvas = p.createCanvas(window.innerWidth, window.innerHeight);
          canvas.parent('p5-bg-canvas');
          p.pixelDensity(1);

          for (let i = 0; i < particleCount; i++) {
            particles.push({
              x: p.random(p.width),
              y: p.random(p.height),
              vx: p.random(-0.7, 0.7),
              vy: p.random(-0.7, 0.7),
              size: p.random(8, 20),
              shapeType: Math.floor(p.random(0, 3)),
              colorIdx: Math.floor(p.random(0, 5)),
              angle: p.random(p.TWO_PI),
              spin: p.random(-0.02, 0.02)
            });
          }
        };

        p.draw = () => {
          p.clear();
          const root = document.getElementById('fajri-terminal');
          const isGui = root && root.dataset.mode === 'gui';

          const guiColors = ['#FFD23F', '#FF6B6B', '#74B9FF', '#B8A9FA', '#88D498'];
          const cliColors = ['rgba(0, 240, 255, 0.5)', 'rgba(255, 46, 149, 0.5)', 'rgba(138, 43, 226, 0.5)'];

          particles.forEach((pt, i) => {
            pt.x += pt.vx;
            pt.y += pt.vy;
            pt.angle += pt.spin;

            pt.vx = bounceVelocity(pt.x, pt.vx, p.width);
            pt.vy = bounceVelocity(pt.y, pt.vy, p.height);

            // Interactive mouse repulsion
            const repelled = repel(pt, p.mouseX, p.mouseY);
            pt.x = repelled.x;
            pt.y = repelled.y;

            p.push();
            p.translate(pt.x, pt.y);
            p.rotate(pt.angle);

            if (isGui) {
              // Neubrutalism mode: bold black outline, solid vibrant shapes
              p.stroke(0);
              p.strokeWeight(2.5);
              p.fill(guiColors[pt.colorIdx % guiColors.length]);

              if (pt.shapeType === 0) {
                p.circle(0, 0, pt.size * 1.3);
              } else if (pt.shapeType === 1) {
                p.rectMode(p.CENTER);
                p.rect(0, 0, pt.size * 1.2, pt.size * 1.2);
              } else {
                p.triangle(-pt.size * 0.8, pt.size * 0.8, pt.size * 0.8, pt.size * 0.8, 0, -pt.size * 0.8);
              }
            } else {
              // Cyberpunk CLI mode: glowing connecting data nodes
              p.noStroke();
              p.fill(cliColors[pt.colorIdx % cliColors.length]);
              p.circle(0, 0, pt.size * 0.55);

              // Connect nearby nodes with glowing line segments
              for (let j = i + 1; j < particles.length; j++) {
                let other = particles[j];
                let d = p.dist(pt.x, pt.y, other.x, other.y);
                if (d < 120) {
                  p.stroke('rgba(0, 240, 255, ' + (0.3 * (1 - d / 120)) + ')');
                  p.strokeWeight(1);
                  p.line(0, 0, other.x - pt.x, other.y - pt.y);
                }
              }
            }
            p.pop();
          });
        };

        p.windowResized = () => p.resizeCanvas(window.innerWidth, window.innerHeight);
      });
    };

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initP5, 200);
    } else {
      window.addEventListener('DOMContentLoaded', () => setTimeout(initP5, 200));
    }
  }
</script>