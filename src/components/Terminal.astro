  document.addEventListener('DOMContentLoaded', function() {
    runBootSequence();

    const input = document.getElementById('terminal-input');
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        const cmd = input.value;
        input.value = '';
        if (cmd.trim()) { handleCommand(cmd); }
      }
      if (e.key === 'Tab') { e.preventDefault(); input.value = 'help'; }
    });

    // Mode toggle (Terminal <-> Neubrutalist GUI)
    const modeToggle = document.getElementById('mode-toggle');
    const guiModeToggle = document.getElementById('gui-mode-toggle');
    const root = document.getElementById('fajri-terminal');
    
    function toggleMode() {
      const isGui = root.dataset.mode === 'gui';
      root.dataset.mode = isGui ? 'terminal' : 'gui';
      if (modeToggle) {
        modeToggle.classList.toggle('active', !isGui);
        const icon = modeToggle.querySelector('.mode-icon');
        const label = modeToggle.querySelector('.mode-label');
        if (icon) icon.textContent = !isGui ? '▣' : '□';
        if (label) label.textContent = !isGui ? 'TERM' : 'GUI';
      }
    }

    if (modeToggle) modeToggle.addEventListener('click', toggleMode);
    if (guiModeToggle) guiModeToggle.addEventListener('click', toggleMode);

    // Parallax Scroll & Mousemove Effects for GUI Mode
    const guiContainer = document.getElementById('neubrutalism-gui');
    if (guiContainer) {
      // 1. Mouse move 3D tilt effect on GUI Hero and Cards
      guiContainer.addEventListener('mousemove', function(e) {
        if (root.dataset.mode !== 'gui') return;
        const rect = guiContainer.getBoundingClientRect();
        const mouseX = e.clientX - rect.left - rect.width / 2;
        const mouseY = e.clientY - rect.top - rect.height / 2;

        document.querySelectorAll('.parallax-shape').forEach(shape => {
          const speed = parseFloat(shape.getAttribute('data-speed')) || 0.1;
          shape.style.transform = `translate3d(${mouseX * speed * 0.4}px, ${mouseY * speed * 0.4}px, 0) rotate(${mouseX * 0.02}deg)`;
        });
      });

      // 2. Scroll Parallax
      window.addEventListener('scroll', function() {
        if (root.dataset.mode !== 'gui') return;
        const scrolled = window.scrollY;
        document.querySelectorAll('#neubrutalism-gui [data-speed]').forEach(el => {
          const speed = parseFloat(el.getAttribute('data-speed')) || 0.05;
          const yPos = -(scrolled * speed);
          el.style.transform = `translate3d(0, ${yPos}px, 0)`;
        });
      });
    }

    input.focus();
  });

  // --- p5.js Interactive Dual-Mode Canvas (Cyberpunk CLI & Neubrutalism GUI) ---
  if (typeof window !== 'undefined') {
    const initP5 = () => {
      if (!window.p5) return;
      new window.p5(p => {
        let particles = [];
        const particleCount = 40;

        p.setup = () => {
          const canvas = p.createCanvas(window.innerWidth, window.innerHeight);
          canvas.parent('p5-bg-canvas');
          p.pixelDensity(1);

          for (let i = 0; i < particleCount; i++) {
            particles.push({
              x: p.random(p.width),
              y: p.random(p.height),
              vx: p.random(-0.7, 0.7),
              vy: p.random(-0.7, 0.7),
              size: p.random(8, 20),
              shapeType: Math.floor(p.random(0, 3)),
              colorIdx: Math.floor(p.random(0, 5)),
              angle: p.random(p.TWO_PI),
              spin: p.random(-0.02, 0.02)
            });
          }
        };

        p.draw = () => {
          p.clear();
          const root = document.getElementById('fajri-terminal');
          const isGui = root && root.dataset.mode === 'gui';

          const guiColors = ['#FFD23F', '#FF6B6B', '#74B9FF', '#B8A9FA', '#88D498'];
          const cliColors = ['rgba(230, 237, 243, 0.25)', 'rgba(88, 166, 255, 0.2)', 'rgba(63, 185, 80, 0.2)'];

          particles.forEach((pt, i) => {
            pt.x += pt.vx;
            pt.y += pt.vy;
            pt.angle += pt.spin;

            if (pt.x < 0 || pt.x > p.width) pt.vx *= -1;
            if (pt.y < 0 || pt.y > p.height) pt.vy *= -1;

            // Interactive mouse repulsion
            let dx = p.mouseX - pt.x;
            let dy = p.mouseY - pt.y;
            let dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 130 && dist > 0) {
              pt.x -= (dx / dist) * 2.5;
              pt.y -= (dy / dist) * 2.5;
            }

            p.push();
            p.translate(pt.x, pt.y);
            p.rotate(pt.angle);

            if (isGui) {
              // Neubrutalism mode: bold black outline, solid vibrant shapes
              p.stroke(0);
              p.strokeWeight(2.5);
              p.fill(guiColors[pt.colorIdx % guiColors.length]);

              if (pt.shapeType === 0) {
                p.circle(0, 0, pt.size * 1.3);
              } else if (pt.shapeType === 1) {
                p.rectMode(p.CENTER);
                p.rect(0, 0, pt.size * 1.2, pt.size * 1.2);
              } else {
                p.triangle(-pt.size * 0.8, pt.size * 0.8, pt.size * 0.8, pt.size * 0.8, 0, -pt.size * 0.8);
              }
            } else {
              // Subtle clean terminal constellation
              p.noStroke();
              p.fill(cliColors[pt.colorIdx % cliColors.length]);
              p.circle(0, 0, pt.size * 0.35);

              // Connect nearby nodes with very delicate hairline segments
              for (let j = i + 1; j < particles.length; j++) {
                let other = particles[j];
                let d = p.dist(pt.x, pt.y, other.x, other.y);
                if (d < 100) {
                  p.stroke('rgba(255, 255, 255, ' + (0.07 * (1 - d / 100)) + ')');
                  p.strokeWeight(1);
                  p.line(0, 0, other.x - pt.x, other.y - pt.y);
                }
              }
            }
            p.pop();
          });
        };

        p.windowResized = () => p.resizeCanvas(window.innerWidth, window.innerHeight);
      });
    };

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initP5, 200);
    } else {
      window.addEventListener('DOMContentLoaded', () => setTimeout(initP5, 200));
    }
  }
