---
import {
  CERTIFICATES,
  GUI_INFO_ROWS,
  LINKS_BY_NAME,
  PROFILE,
  SKILLS,
  SOCIAL_LINKS,
} from '../data/portfolio';

const heroBadges = [
  { color: 'yellow', icon: 'school', text: `${PROFILE.institutionShort} 2026` },
  { color: 'coral', icon: 'movie', text: 'AFTER EFFECTS' },
  { color: 'sky', icon: 'smart_toy', text: 'HERMES AGENT' },
];

const heroActions = [
  { color: 'coral', icon: 'person', label: 'Profil', href: '#gui-profile' },
  { color: 'yellow', icon: 'electric_bolt', label: 'Skill', href: '#gui-skills' },
  { color: 'sky', icon: 'verified', label: 'Lisensi', href: '#gui-assets' },
  {
    color: 'lavender',
    icon: 'play_circle',
    label: 'YouTube',
    href: LINKS_BY_NAME.YouTube.url,
    external: true,
  },
];
---

<div id="p5-bg-canvas"></div>
<div id="fajri-terminal" class="terminal-root" data-mode="terminal">
  <div class="terminal-scanlines"></div>
  <div class="terminal-hud-glow"></div>

  <div class="terminal-header">
    <span class="terminal-title">
      <span class="pulse-dot"></span> {PROFILE.agent} // {PROFILE.agentVersion} <span class="dim">ASTRO-HERMES TERMINAL</span>
    </span>
    <div class="terminal-window-controls">
      <span class="control-btn" data-color="#ff5f56"></span>
      <span class="control-btn" data-color="#ffbd2e"></span>
      <span class="control-btn" data-color="#27c93f"></span>
    </div>
    <button id="mode-toggle" class="mode-toggle" title="Toggle Terminal / Neubrutalist GUI">
      <span class="mode-icon">□</span>
      <span class="mode-label">GUI</span>
    </button>
  </div>

  <div class="terminal-body" id="terminal-body">
    <!-- typed line-by-line via JS -->
  </div>

  <div class="terminal-input-zone">
    <span class="input-prompt">$</span>
    <input type="text" id="terminal-input" class="terminal-input" autocomplete="off" spellcheck="false"
           placeholder="Ketik [1] SKILLS | [2] ASSETS/LICENSE | [3] LINKS | [4] PROFILE" />
  </div>

  <div class="terminal-status">
    <span class="status-item">PORT: <span class="highlight">{PROFILE.port}</span></span>
    <span class="status-item">STATUS: <span class="highlight success">200 OK</span></span>
    <span class="status-item">CONN: <span class="highlight">SECURE</span></span>
    <span class="status-item">AGENT: <span class="highlight warn">{PROFILE.agent} ACTIVE</span></span>
  </div>

  <!-- GUI Mode Content (Modern Neubrutalism Portfolio Website) -->
  <div id="neubrutalism-gui" class="gui-container">
    <header class="gui-header">
      <div class="gui-brand">
        <img src={PROFILE.logo} alt={`${PROFILE.institutionShort} Logo`} class="gui-brand-logo" width="36" height="36" />
        <div class="gui-brand-text">
          <span class="gui-brand-title">{PROFILE.fullName.toUpperCase()}</span>
          <span class="gui-brand-sub">{PROFILE.institutionShort} • {PROFILE.major.toUpperCase()} 2026</span>
        </div>
      </div>
      <div class="gui-nav-actions">
        <span class="gui-status-pill"><span class="material-symbols-outlined nav-icon">bolt</span> {PROFILE.agent} ONLINE</span>
        <button id="gui-mode-toggle" class="gui-toggle-btn">
          <span class="material-symbols-outlined gui-btn-icon">terminal</span> SWITCH TO TERMINAL
        </button>
      </div>
    </header>

    <!-- Parallax background floating shapes -->
    <div class="gui-parallax-bg">
      <div class="parallax-shape shape-1" data-speed="0.15"></div>
      <div class="parallax-shape shape-2" data-speed="-0.2"></div>
      <div class="parallax-shape shape-3" data-speed="0.25"></div>
    </div>

    <section class="gui-hero">
      <div class="gui-hero-text">
        <div class="gui-badge-row">
          {heroBadges.map((badge, i) => (
            <span class={`nb-badge nb-badge-${badge.color}`} style={`--i: ${i}`}>
              <span class="material-symbols-outlined badge-icon">{badge.icon}</span> {badge.text}
            </span>
          ))}
        </div>
        <h1 class="gui-hero-title">CREATIVE CODER & MOTION DESIGNER</h1>
        <p class="gui-hero-desc">
          Halo! Saya <strong>{PROFILE.fullName}</strong> (@{PROFILE.username}), mahasiswa {PROFILE.major}{' '}
          <strong>{PROFILE.institution} ({PROFILE.institutionShort})</strong> Semarang & alumni {PROFILE.priorEducation}.
          Spesialisasi di bidang video editing After Effects, prompt engineering AI agent, dan web development.
        </p>
        <div class="gui-hero-actions">
          {heroActions.map((action, i) => (
            <a
              href={action.href}
              class={`nb-btn nb-btn-${action.color}`}
              style={`--i: ${i}`}
              target={action.external ? '_blank' : undefined}
              rel={action.external ? 'noopener' : undefined}
            >
              <span class="material-symbols-outlined btn-icon">{action.icon}</span> {action.label}
            </a>
          ))}
        </div>
      </div>
      <div class="gui-hero-avatar-box" data-speed="0.08">
        <div class="gui-avatar-card">
          <img src={PROFILE.avatar} alt={PROFILE.fullName} class="gui-avatar-img" width="260" height="260" loading="eager" decoding="async" />
          <div class="gui-avatar-caption">
            <strong>{PROFILE.fullName}</strong>
            <span>@{PROFILE.username} • {PROFILE.location}</span>
          </div>
        </div>
      </div>
    </section>

    <div class="gui-grid">
      <section id="gui-profile" class="nb-card nb-card-yellow" data-speed="0.05" style="--i: 0">
        <div class="nb-card-header">
          <h2><span class="material-symbols-outlined section-icon">badge</span> INFORMASI DIRI</h2>
          <span class="nb-card-tag">PROFILE</span>
        </div>
        <div class="gui-info-list">
          {GUI_INFO_ROWS.map((row) => (
            <div class="gui-info-item">
              <span class="info-label">{row.label}</span>
              <span class="info-val">
                {row.icon && <span class="material-symbols-outlined inline-icon">{row.icon}</span>}{' '}
                {row.value}
              </span>
            </div>
          ))}
        </div>
      </section>

      <section id="gui-skills" class="nb-card nb-card-lavender" data-speed="-0.05" style="--i: 1">
        <div class="nb-card-header">
          <h2><span class="material-symbols-outlined section-icon">psychology</span> SKILLS & EXPERTISE</h2>
          <span class="nb-card-tag">SKILLS</span>
        </div>
        <div class="gui-skills-container">
          {SKILLS.map((skill) => (
            <div class="gui-skill-item">
              <div class="gui-skill-meta">
                <span><span class="material-symbols-outlined skill-icon">{skill.icon}</span> {skill.name}</span>
                <strong>[{skill.level}] {skill.pct}%</strong>
              </div>
              <div class="gui-progress-bar">
                <div class={`gui-progress-fill ${skill.guiFill}`} style={`width: ${skill.pct}%;`}></div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="gui-assets" class="nb-card nb-card-sky" data-speed="0.08" style="--i: 2">
        <div class="nb-card-header">
          <h2><span class="material-symbols-outlined section-icon">workspace_premium</span> SERTIFIKAT & LISENSI</h2>
          <span class="nb-card-tag">DOWNLOADS</span>
        </div>
        <div class="gui-asset-list">
          {CERTIFICATES.map(({ file, certificate }) => (
            <a href={`/assets/${file}`} target="_blank" class="gui-asset-link">
              <span class="material-symbols-outlined asset-icon">{certificate!.icon}</span>
              <div class="asset-details">
                <strong>{certificate!.title}</strong>
                <small>{certificate!.description}</small>
              </div>
              <span class="nb-mini-btn">UNDUH</span>
            </a>
          ))}
        </div>
      </section>

      <section id="gui-links" class="nb-card nb-card-coral" data-speed="-0.08" style="--i: 3">
        <div class="nb-card-header">
          <h2><span class="material-symbols-outlined section-icon">share</span> MEDIA SOSIAL & PORTAL</h2>
          <span class="nb-card-tag">CONNECT</span>
        </div>
        <div class="gui-link-grid">
          {SOCIAL_LINKS.map((link) => (
            <a href={link.url} target="_blank" rel="noopener" class="gui-social-btn">
              <img src={link.logo} alt={link.name} width="22" height="22" />
              <span>{link.label}</span>
            </a>
          ))}
        </div>
      </section>

      <section id="gui-snake" class="nb-card nb-card-snake" data-speed="0.04" style="--i: 4">
        <div class="nb-card-header">
          <h2><span class="material-symbols-outlined section-icon">conversion_path</span> GITHUB CONTRIBUTIONS</h2>
          <span class="nb-card-tag">ACTIVITY</span>
        </div>
        <div class="gui-snake-wrap">
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset="https://raw.githubusercontent.com/LazenFajri/Portofolio/output/github-contribution-grid-snake-dark.svg" />
            <img
              src="https://raw.githubusercontent.com/LazenFajri/Portofolio/output/github-contribution-grid-snake.svg"
              alt={`GitHub Contribution Snake Animation ${PROFILE.username}`}
              class="gui-snake-img"
              loading="lazy"
              onerror="this.closest('.gui-snake-wrap').innerHTML='<p class=\'snake-pending\'>🐍 Snake animation akan muncul setelah GitHub Actions pertama kali berjalan.</p>'"
            />
          </picture>
        </div>
      </section>
    </div>
  </div>
</div>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&family=JetBrains+Mono:wght@400;500;600;700&family=Fira+Code:wght@400;500;600;700&display=swap');

  :root {
    /* Terminal colors (cyberpunk) */
    --bg: #0d0215;
    --bg-card: #110422;
    --text-primary: #e0d8ff;
    --text-dim: #7a6aa1;
    --text-dimmer: #4b3d65;
    --accent-cyan: #00f0ff;
    --accent-pink: #ff2e95;
    --accent-purple: #8a2be2;
    --accent-gold: #ffd700;
    --border: #2d1a42;
    --border-bright: #5a3a8a;
    --glow-cyan: 0 0 8px var(--accent-cyan), 0 0 20px var(--accent-cyan);
    --glow-pink: 0 0 8px var(--accent-pink), 0 0 20px var(--accent-pink);
    --glow-purple: 0 0 6px var(--accent-purple), 0 0 16px var(--accent-purple);

    /* Neubrutalism tokens (from neubrutalism.com) */
    --nb-black: #000000;
    --nb-white: #FFFDF5;
    --nb-yellow: #FFD23F;
    --nb-coral: #FF6B6B;
    --nb-sky: #74B9FF;
    --nb-green: #88D498;
    --nb-orange: #FFA552;
    --nb-lavender: #B8A9FA;

    /* Shared easings; `--i` on an element sets its index in a staggered sequence. */
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-back: cubic-bezier(0.34, 1.56, 0.64, 1);

    --nb-stroke: 3px;
    --nb-radius: 0;
    --nb-shadow-sm: 3px 3px 0 0 var(--nb-black);
    --nb-shadow-md: 5px 5px 0 0 var(--nb-black);
    --nb-shadow-lg: 8px 8px 0 0 var(--nb-black);

    /* Fonts */
    --font-display: 'Syne', 'Space Grotesk', sans-serif;
    --font-heading: 'Space Grotesk', 'Syne', sans-serif;
    --font-body: 'Inter', 'Space Mono', monospace;
    --font-mono: 'Space Mono', 'JetBrains Mono', monospace;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: radial-gradient(ellipse at top, #140225 0%, var(--bg) 100%);
    min-height: 100vh;
    font-family: var(--font-body);
    overflow-x: hidden;
    color: var(--text-primary);
    line-height: 1.6;
  }

  /* ============================================================
     TERMINAL MODE (default)
     ============================================================ */

  .terminal-root {
    position: relative;
    width: 100%;
    max-width: 900px;
    min-height: 520px;
    margin: 2rem auto;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow:
      0 0 1px var(--border-bright),
      0 0 6px var(--border-bright),
      inset 0 0 30px rgba(138, 43, 226, 0.08);
    overflow: hidden;
    backdrop-filter: blur(4px);
  }

  .terminal-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(13, 2, 21, 0.15) 0px,
      rgba(13, 2, 21, 0.15) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
    z-index: 1;
  }

  .terminal-hud-glow {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 0%, rgba(0, 240, 255, 0.03) 50%, transparent 100%),
      linear-gradient(rgba(255, 46, 149, 0.04), transparent 80%);
    pointer-events: none;
    z-index: 0;
    opacity: 0.8;
  }

  /* Terminal Header with macOS-style controls */
  .terminal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1.2rem;
    background: rgba(13, 2, 21, 0.6);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(4px);
    z-index: 2;
    position: relative;
  }

  .terminal-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-cyan);
    letter-spacing: 1px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 8px var(--accent-cyan);
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.8; box-shadow: 0 0 4px var(--accent-cyan), 0 0 8px var(--accent-cyan); }
    50% { opacity: 1; box-shadow: 0 0 6px var(--accent-cyan), 0 0 12px var(--accent-cyan), 0 0 20px var(--accent-cyan); }
  }

  .dim { color: var(--text-dim); }
  .terminal-title .dim { font-weight: 400; }

  .terminal-window-controls {
    display: flex;
    gap: 6px;
  }

  .control-btn {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .control-btn:nth-child(1) { background: #ff5f56; }
  .control-btn:nth-child(2) { background: #ffbd2e; }
  .control-btn:nth-child(3) { background: #27c93f; }

  /* Terminal body */
  .terminal-body {
    padding: 1.5rem 1.5rem 1rem;
    min-height: 380px;
    font-size: 0.82rem;
    line-height: 1.5;
    z-index: 2;
    position: relative;
    overflow-y: auto;
  }

  .terminal-body::-webkit-scrollbar { width: 6px; }
  .terminal-body::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.2); }
  .terminal-body::-webkit-scrollbar-thumb { background: var(--accent-purple); border-radius: 3px; }

  /* Output lines */
  .line {
    margin-bottom: 0.2rem;
    opacity: 0;
    animation: fadeSlide 0.3s forwards;
    animation-delay: calc(var(--line-delay-index, 0) * 80ms);
  }

  /* Shared fade + slide entrance; `--slide-from` sets the travel distance. */
  @keyframes fadeSlide {
    from { opacity: 0; transform: translateY(var(--slide-from, 8px)); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Chip-like labels (terminal tags, profile badges): one shape, one accent var. */
  .tag, .badge {
    display: inline-block;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 3px;
    background: rgba(var(--chip-rgb), 0.15);
    color: rgb(var(--chip-rgb));
    border: 1px solid rgba(var(--chip-rgb), 0.3);
  }
  .tag {
    padding: 0.1rem 0.45rem;
    font-size: 0.75rem;
    margin-right: 0.4rem;
  }
  .tag-sys { --chip-rgb: 0, 240, 255; }
  .tag-prof { --chip-rgb: 255, 46, 149; }
  .tag-asset { --chip-rgb: 138, 43, 226; }
  .tag-ok { --chip-rgb: 39, 201, 63; }
  .tag-warn { --chip-rgb: 255, 189, 46; }

  .highlight, .highlight-cyan { color: var(--accent-cyan); }
  .highlight-pink, .makan { color: var(--accent-pink); }
  .highlight-purple { color: var(--accent-purple); }
  .highlight-gold { color: var(--accent-gold); }
  .success { color: #27c93f; }
  .warn { color: #ffbd2e; }

  .divider {
    color: var(--border-bright);
    text-align: center;
    margin: 0.6rem 0;
    letter-spacing: 2px;
  }

  .ascii-box {
    border: 1px solid var(--border-bright);
    border-radius: 4px;
    padding: 0.1px;
    margin: 0.5rem 0;
    font-size: 0.78rem;
    background: rgba(13, 2, 21, 0.3);
  }
  .ascii-box-inner {
    border: 1px solid var(--border-bright);
    border-radius: 3px;
    padding: 0.6rem 0.8rem;
    background: rgba(0, 0, 0, 0.25);
  }
  .ascii-box-title {
    background: var(--border-bright);
    color: var(--bg);
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1px;
    border-radius: 2px;
    margin-bottom: 0.4rem;
  }

  .skill-bar { margin: 0.3rem 0; }
  .skill-name {
    display: flex; justify-content: space-between;
    margin-bottom: 0.15rem; font-size: 0.78rem;
  }
  .skill-name span { color: var(--accent-cyan); }
  .skill-name .level-label { color: var(--text-dim); }
  .skill-track {
    height: 8px; background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border); border-radius: 4px; overflow: hidden; position: relative;
  }
  .skill-fill {
    height: 100%; border-radius: 3px;
    transition: width 0.8s ease, background-color 0.3s;
    display: flex; align-items: center; justify-content: flex-end; padding-right: 4px;
  }
  .skill-fill .bar-text {
    font-size: 0.68rem; font-weight: 700; color: var(--bg);
    text-shadow: 0 0 3px rgba(0, 0, 0, 0.7);
  }

  .asset-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.4rem; margin: 0.5rem 0;
  }
  .asset-item {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.3rem 0.5rem; border-radius: 4px;
    background: rgba(0, 0, 0, 0.2); border: 1px solid var(--border);
    font-size: 0.72rem; transition: all 0.2s;
  }
  .asset-item:hover {
    background: rgba(138, 43, 226, 0.1); border-color: var(--accent-purple);
    transform: translateX(2px);
  }
  .asset-icon { font-size: 1.1rem; }
  .asset-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-primary); }
  .asset-size { color: var(--text-dim); font-size: 0.65rem; }

  .link-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.4rem; margin: 0.5rem 0;
  }
  .link-item {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.4rem 0.5rem; border-radius: 4px;
    background: rgba(0, 0, 0, 0.2); border: 1px solid var(--border);
    font-size: 0.8rem; transition: all 0.2s; text-decoration: none;
  }
  .link-item:hover {
    background: rgba(0, 240, 255, 0.08); border-color: var(--accent-cyan);
    transform: translateX(2px);
  }
  .link-item .link-icon { font-size: 1.2rem; min-width: 24px; text-align: center; }
  .link-item .link-text { color: var(--text-primary); flex: 1; }
  .link-item .link-url { color: var(--text-dim); font-size: 0.68rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 140px; }

  .terminal-input-zone {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.6rem 1.5rem;
    background: rgba(0, 0, 0, 0.3);
    border-top: 1px solid var(--border);
    z-index: 2; position: relative;
  }

  .input-prompt { color: var(--accent-cyan); font-weight: 700; font-size: 0.9rem; text-shadow: var(--glow-cyan); }

  .terminal-input {
    flex: 1; background: transparent; border: none;
    color: var(--text-primary);
    font-family: var(--font-mono); font-size: 0.82rem;
    outline: none; caret-color: var(--accent-pink);
  }
  .terminal-input::placeholder { color: var(--text-dim); }

  .terminal-status {
    display: flex; justify-content: space-around; align-items: center;
    padding: 0.4rem 1rem;
    background: rgba(0, 0, 0, 0.3);
    border-top: 1px solid var(--border);
    font-size: 0.72rem; z-index: 2; position: relative;
    flex-wrap: wrap; gap: 0.3rem;
  }
  .status-item { display: flex; align-items: center; gap: 0.25rem; }

  /* Profile card (terminal) */
  .profile-grid {
    display: grid; grid-template-columns: 90px 1fr; gap: 0.5rem;
    margin: 0.5rem 0; align-items: start;
  }
  .profile-pic {
    width: 64px; height: 64px;
    border-radius: 6px; object-fit: cover;
    border: 2px solid var(--accent-cyan);
    box-shadow: var(--glow-cyan);
    image-rendering: pixelated;
  }
  .profile-details { display: flex; flex-direction: column; gap: 0.15rem; font-size: 0.78rem; }
  .profile-details .label { color: var(--text-dim); }
  .profile-details .value { color: var(--text-primary); }
  .badge {
    padding: 0.1rem 0.3rem;
    font-size: 0.62rem;
    margin-top: 0.2rem; align-self: flex-start;
  }
  .badge-student { --chip-rgb: 0, 240, 255; }
  .badge-coder { --chip-rgb: 255, 46, 149; }

  /* Mode Toggle Button */
  .mode-toggle {
    display: flex; align-items: center; gap: 0.3rem;
    padding: 0.3rem 0.5rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--border); border-radius: 4px;
    color: var(--text-dim);
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700;
    cursor: pointer; transition: all 0.2s;
  }
  .mode-toggle:hover { background: rgba(0, 240, 255, 0.1); border-color: var(--accent-cyan); color: var(--accent-cyan); }
  .mode-toggle.active { background: rgba(0, 240, 255, 0.2); border-color: var(--accent-cyan); color: var(--accent-cyan); }
  .mode-icon { font-size: 0.8rem; }

  /* ============================================================
     P5.JS BACKGROUND CANVAS
     ============================================================ */

  #p5-bg-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  #p5-bg-canvas canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  /* ============================================================
     NEUBRUTALISM GUI MODE (Modern Portfolio Website)
     ============================================================ */

  #neubrutalism-gui {
    display: none;
    background: var(--nb-white);
    color: var(--nb-black);
    padding: 1.5rem;
    font-family: var(--font-body);
    position: relative;
    overflow: hidden;
  }

  /* Material Symbols styling inside GUI */
  #neubrutalism-gui .material-symbols-outlined {
    font-size: 1.15em;
    vertical-align: middle;
    font-variation-settings: 'FILL' 1, 'wght' 600, 'GRAD' 0, 'opsz' 24;
    display: inline-block;
  }
  .nav-icon { font-size: 1rem !important; margin-right: 3px; color: var(--nb-coral); }
  .gui-btn-icon { font-size: 1.1rem !important; margin-right: 4px; }
  .badge-icon { font-size: 0.9rem !important; margin-right: 3px; }
  .btn-icon { font-size: 1.1rem !important; margin-right: 4px; }
  .section-icon { font-size: 1.25rem !important; margin-right: 6px; color: var(--nb-black); }
  .skill-icon { font-size: 1.05rem !important; margin-right: 4px; }
  .inline-icon { font-size: 1rem !important; margin-right: 4px; color: var(--nb-coral); }
  .asset-icon { font-size: 1.8rem !important; color: var(--nb-black); }

  /* Parallax Background Floating Elements */
  .gui-parallax-bg {
    position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 0;
  }
  .parallax-shape {
    position: absolute; border: 2px solid var(--nb-black);
    box-shadow: 3px 3px 0 0 var(--nb-black); opacity: 0.12;
    transition: transform 0.1s ease-out;
  }
  .shape-1 { top: 8%; right: 4%; width: 70px; height: 70px; background: var(--nb-coral); transform: rotate(15deg); }
  .shape-2 { top: 48%; left: 2%; width: 45px; height: 45px; background: var(--nb-yellow); transform: rotate(-20deg); border-radius: 50%; }
  .shape-3 { bottom: 12%; right: 6%; width: 90px; height: 40px; background: var(--nb-sky); transform: rotate(8deg); }

  .gui-hero, .nb-card { position: relative; z-index: 1; transition: transform 0.15s ease-out, box-shadow 0.15s ease-out; }

  /* Snake Contribution Card */
  .nb-card-snake {
    background: #1a1a2e;
    border: 3px solid var(--nb-black);
    box-shadow: var(--nb-shadow-md);
    padding: 1.2rem;
    grid-column: 1 / -1;
  }
  .nb-card-snake .nb-card-header h2 { color: #88D498; }
  .nb-card-snake .nb-card-tag { background: #88D498; color: #000; }
  .gui-snake-wrap {
    width: 100%;
    overflow: hidden;
    border: 2px solid var(--nb-black);
    background: #0d1117;
    padding: 0.5rem;
    margin-top: 0.75rem;
  }
  .gui-snake-img {
    width: 100%;
    height: auto;
    display: block;
    image-rendering: pixelated;
  }
  .snake-pending {
    text-align: center;
    padding: 2rem 1rem;
    color: #88D498;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    opacity: 0.7;
  }

  /* ============================================================
     RELOAD / ENTRANCE ANIMATIONS (CLI & GUI)
     ============================================================ */

  .terminal-root {
    animation: terminalPop 0.6s var(--ease-out) forwards;
  }

  @keyframes terminalPop {
    0% { opacity: 0; transform: translateY(24px) scale(0.97); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  .terminal-root .terminal-header {
    --slide-from: -15px;
    animation: fadeSlide 0.5s 0.1s var(--ease-out) both;
  }
  .terminal-root .terminal-status {
    --slide-from: 15px;
    animation: fadeSlide 0.5s 0.3s var(--ease-out) both;
  }
  .terminal-root .terminal-input-zone {
    animation: cliInputSlide 0.5s 0.2s var(--ease-out) both;
  }

  @keyframes cliInputSlide {
    0% { opacity: 0; transform: scaleX(0.95); }
    100% { opacity: 1; transform: scaleX(1); }
  }

  /* Neubrutalism GUI Staggered Reload Animations (stagger driven by `--i`) */
  .terminal-root[data-mode="gui"] .gui-header {
    --slide-from: -25px;
    animation: fadeSlide 0.5s var(--ease-out) both;
  }

  .terminal-root[data-mode="gui"] .gui-hero {
    animation: nbHeroPop 0.6s 0.15s var(--ease-back) both;
  }

  .terminal-root[data-mode="gui"] .nb-badge {
    animation: nbBadgeScale 0.4s var(--ease-back) both;
    animation-delay: calc(0.3s + var(--i, 0) * 0.1s);
  }

  .terminal-root[data-mode="gui"] .gui-hero-title,
  .terminal-root[data-mode="gui"] .gui-hero-desc {
    --slide-from: 12px;
    animation: fadeSlide 0.5s 0.35s var(--ease-out) both;
  }
  .terminal-root[data-mode="gui"] .gui-hero-desc { animation-delay: 0.45s; }

  .terminal-root[data-mode="gui"] .nb-btn {
    animation: nbBtnBounce 0.4s var(--ease-back) both;
    animation-delay: calc(0.5s + var(--i, 0) * 0.08s);
  }

  .terminal-root[data-mode="gui"] .gui-avatar-card {
    animation: nbAvatarTilt 0.65s 0.3s var(--ease-back) both;
  }

  .terminal-root[data-mode="gui"] .gui-grid > .nb-card {
    animation: nbCardEntry 0.5s var(--ease-out) both;
    animation-delay: calc(0.45s + var(--i, 0) * 0.1s);
  }

  @keyframes nbHeroPop {
    0% { opacity: 0; transform: scale(0.93) translateY(20px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  @keyframes nbBadgeScale {
    0% { opacity: 0; transform: scale(0.4) rotate(-8deg); }
    100% { opacity: 1; transform: scale(1) rotate(0); }
  }

  @keyframes nbBtnBounce {
    0% { opacity: 0; transform: translateY(16px) scale(0.88); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes nbAvatarTilt {
    0% { opacity: 0; transform: scale(0.85) rotate(-6deg) translateY(25px); }
    100% { opacity: 1; transform: scale(1) rotate(0) translateY(0); }
  }

  @keyframes nbCardEntry {
    0% { opacity: 0; transform: translateY(30px) scale(0.96); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  .terminal-root[data-mode="gui"] #neubrutalism-gui {
    display: block;
  }

  .terminal-root[data-mode="gui"] .terminal-scanlines,
  .terminal-root[data-mode="gui"] .terminal-hud-glow,
  .terminal-root[data-mode="gui"] .terminal-header,
  .terminal-root[data-mode="gui"] .terminal-body,
  .terminal-root[data-mode="gui"] .terminal-input-zone,
  .terminal-root[data-mode="gui"] .terminal-status {
    display: none !important;
  }

  .terminal-root[data-mode="gui"] {
    background: var(--nb-white);
    border: var(--nb-stroke) solid var(--nb-black);
    border-radius: var(--nb-radius);
    box-shadow: var(--nb-shadow-lg);
    max-width: 1000px;
    margin: 1.5rem auto;
    min-height: auto;
  }

  /* Neubrutalism Header */
  .gui-header {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: 1.2rem; margin-bottom: 1.5rem;
    border-bottom: var(--nb-stroke) solid var(--nb-black);
    flex-wrap: wrap; gap: 1rem;
  }
  .gui-brand { display: flex; align-items: center; gap: 0.8rem; }
  .gui-brand-logo { border: 2px solid var(--nb-black); border-radius: 4px; background: var(--nb-yellow); object-fit: contain; }
  .gui-brand-text { display: flex; flex-direction: column; }
  .gui-brand-title { font-family: var(--font-heading); font-weight: 800; font-size: 1.1rem; letter-spacing: 0.05em; }
  .gui-brand-sub { font-size: 0.72rem; font-family: var(--font-mono); font-weight: 700; opacity: 0.7; }
  .gui-nav-actions { display: flex; align-items: center; gap: 0.8rem; }
  .gui-status-pill {
    background: var(--nb-yellow); border: 2px solid var(--nb-black);
    padding: 0.3rem 0.6rem; font-size: 0.75rem; font-family: var(--font-mono); font-weight: 700;
    box-shadow: 2px 2px 0 0 var(--nb-black);
  }
  .gui-toggle-btn {
    background: var(--nb-coral); color: var(--nb-white);
    border: var(--nb-stroke) solid var(--nb-black);
    padding: 0.4rem 0.9rem; font-family: var(--font-heading); font-weight: 800; font-size: 0.82rem;
    cursor: pointer; box-shadow: var(--nb-shadow-sm); transition: all 0.15s;
  }
  .gui-toggle-btn:hover { background: var(--nb-black); color: var(--nb-yellow); }

  /* Shared neubrutalist "lift" hover: nudge up-left and deepen the hard shadow. */
  .nb-btn:hover,
  .gui-toggle-btn:hover,
  .gui-asset-link:hover,
  .gui-social-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--nb-shadow-md);
  }
  .nb-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--nb-shadow-lg);
  }

  /* Neubrutalism Hero */
  .gui-hero {
    display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 2rem;
    padding: 1.5rem; background: var(--nb-yellow);
    border: var(--nb-stroke) solid var(--nb-black);
    box-shadow: var(--nb-shadow-md); margin-bottom: 2rem;
    align-items: center;
  }
  .gui-badge-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .nb-badge {
    border: 2px solid var(--nb-black); padding: 0.2rem 0.6rem;
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    box-shadow: 2px 2px 0 0 var(--nb-black);
  }
  .nb-badge-yellow { background: var(--nb-white); color: var(--nb-black); }
  .nb-badge-coral { background: var(--nb-coral); color: var(--nb-white); }
  .nb-badge-sky { background: var(--nb-sky); color: var(--nb-black); }

  .gui-hero-title {
    font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800;
    line-height: 1.1; margin-bottom: 1rem; text-transform: uppercase;
  }
  .gui-hero-desc { font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; }
  .gui-hero-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }

  .nb-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    border: var(--nb-stroke) solid var(--nb-black); padding: 0.5rem 1rem;
    font-family: var(--font-heading); font-weight: 700; font-size: 0.85rem; text-decoration: none;
    color: var(--nb-black); box-shadow: var(--nb-shadow-sm); transition: all 0.15s;
    cursor: pointer;
  }
  .nb-btn-coral { background: var(--nb-coral); color: var(--nb-white); }
  .nb-btn-yellow { background: var(--nb-white); }
  .nb-btn-sky { background: var(--nb-sky); }
  .nb-btn-lavender { background: var(--nb-lavender); }

  .gui-hero-avatar-box { display: flex; justify-content: center; }
  .gui-avatar-card {
    background: var(--nb-white); border: var(--nb-stroke) solid var(--nb-black);
    padding: 0.8rem; box-shadow: var(--nb-shadow-md); text-align: center; width: 100%; max-width: 280px;
  }
  .gui-avatar-img {
    width: 100%; height: 240px; object-fit: cover;
    border: 2px solid var(--nb-black); margin-bottom: 0.8rem;
  }
  .gui-avatar-caption strong { display: block; font-family: var(--font-heading); font-size: 0.95rem; font-weight: 800; }
  .gui-avatar-caption span { font-size: 0.75rem; font-family: var(--font-mono); opacity: 0.7; }

  /* Neubrutalism Cards Grid */
  .gui-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .nb-card {
    border: var(--nb-stroke) solid var(--nb-black); padding: 1.5rem;
    box-shadow: var(--nb-shadow-md); transition: transform 0.15s;
  }
  .nb-card-yellow { background: var(--nb-yellow); }
  .nb-card-lavender { background: var(--nb-lavender); }
  .nb-card-sky { background: var(--nb-sky); }
  .nb-card-coral { background: var(--nb-coral); }

  .nb-card-header {
    display: flex; justify-content: space-between; align-items: center;
    border-bottom: 2px solid var(--nb-black); padding-bottom: 0.6rem; margin-bottom: 1rem;
  }
  .nb-card-header h2 { font-family: var(--font-heading); font-size: 1.1rem; font-weight: 800; }
  .nb-card-tag {
    background: var(--nb-black); color: var(--nb-white);
    padding: 0.15rem 0.5rem; font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700;
  }

  .gui-info-list { display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.88rem; }
  .gui-info-item { display: flex; flex-direction: column; }
  .info-label { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; opacity: 0.7; text-transform: uppercase; }
  .info-val { font-weight: 700; }

  .gui-skills-container { display: flex; flex-direction: column; gap: 1rem; }
  .gui-skill-meta { display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 700; margin-bottom: 0.3rem; }
  .gui-progress-bar {
    background: var(--nb-white); border: 2px solid var(--nb-black);
    height: 20px; box-shadow: 2px 2px 0 0 var(--nb-black);
  }
  .gui-progress-fill { height: 100%; border-right: 2px solid var(--nb-black); }
  .gui-progress-fill.coral { background: var(--nb-coral); }
  .gui-progress-fill.sky { background: var(--nb-sky); }
  .gui-progress-fill.yellow { background: var(--nb-yellow); }

  .gui-asset-list, .gui-link-grid { display: flex; flex-direction: column; gap: 0.7rem; }

  /* Shared card-style link (certificate rows + social buttons) */
  .gui-asset-link, .gui-social-btn {
    display: flex; align-items: center; gap: 0.8rem;
    background: var(--nb-white); border: 2px solid var(--nb-black);
    text-decoration: none; color: var(--nb-black);
    box-shadow: var(--nb-shadow-sm); transition: all 0.15s;
  }
  .gui-asset-link { padding: 0.7rem 0.9rem; }
  .gui-social-btn {
    padding: 0.8rem 1rem;
    font-family: var(--font-heading); font-weight: 800; font-size: 0.9rem;
  }
  .gui-asset-link:hover, .gui-social-btn:hover { background: var(--nb-yellow); }
  .asset-icon { font-size: 1.4rem; }
  .asset-details { flex: 1; display: flex; flex-direction: column; }
  .asset-details strong { font-size: 0.85rem; font-weight: 800; }
  .asset-details small { font-size: 0.7rem; opacity: 0.7; }
  .nb-mini-btn {
    background: var(--nb-black); color: var(--nb-white);
    padding: 0.2rem 0.5rem; font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700;
  }

  @media (max-width: 768px) {
    .gui-hero { grid-template-columns: 1fr; }
    .gui-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import {
    ASSET_FILES,
    LINKS_BY_NAME,
    PROFILE,
    SKILLS,
    SOCIAL_LINKS,
    TERMINAL_INFO_ROWS,
  } from '../data/portfolio';
  import {
    appendDivider,
    appendGrid,
    appendLine,
    appendSkillBar,
    appendToBody,
    createEl,
    createLine,
    escapeHtml,
    formatTime,
    getTerminalBody,
  } from '../utils/terminal-dom';

  const HINT = 'Ketik [1] SKILLS | [2] ASSETS/LICENSE | [3] LINKS | [4] PROFILE';

  // --- Terminal content data ---
  const bootSequence = [
    { text: '', delay: 0, skip: true },
    { text: `[${PROFILE.agent} // ASTRO ENGINE INITIALIZED]`, delay: 0, cls: 'highlight-purple' },
    {
      text: `STATUS: ONLINE // PORT: ${PROFILE.port} // <span class="success">200 OK</span>`,
      delay: 0,
      cls: 'highlight',
    },
    { text: '', delay: 80, skip: true },
    { text: 'BOOTING TERMINAL … ██████████ (100%)', delay: 0, cls: 'highlight-cyan' },
    { text: 'INITIALIZING HUD… CYBERPUNK THEME ACTIVE', delay: 0, cls: 'success' },
    { text: `MOUNTING /assets/ — ${ASSET_FILES.length} files indexed`, delay: 0, cls: 'highlight-pink' },
    { text: `CONNECTING TO GITHUB.COM/${PROFILE.username.toUpperCase()} …`, delay: 0, cls: 'highlight' },
    { text: 'CONNECTION ESTABLISHED // TLS 1.3 // SECURE', delay: 0, cls: 'success' },
    { text: '', delay: 80, skip: true },
    { text: '[SYS_PROFILE]', delay: 0, cls: 'tag-sys' },
    {
      text: `AGENT_ID  : <span class="highlight-pink">${PROFILE.agent} [${PROFILE.agentVersion}]</span>`,
      delay: 0,
    },
    {
      text: `HOST_NAME : <span class="highlight">${PROFILE.fullName} (${PROFILE.username})</span>`,
      delay: 0,
    },
    {
      text: `MAJOR     : <span class="highlight">${PROFILE.major} @ ${PROFILE.institutionShort}</span>`,
      delay: 0,
    },
    { text: `ALUMNUS   : <span class="highlight">SMKN 7 Semarang</span>`, delay: 0 },
    { text: '', delay: 80, skip: true },
    { text: '[SYSTEM READY] — Interactive mode. Type a command.', delay: 0, cls: 'success' },
  ];

  const skillsData = {
    title: '[01 // SKILLS]',
    tag: 'tag-sys',
    lines: [
      '',
      '<span class="dim">TECH_STACK & PROFICIENCY</span>',
      '',
      ...SKILLS.map(
        (skill) => `${skill.name} <span class="${skill.cliHighlight}">[${skill.level}]</span>`,
      ),
      '',
      'Proficiency: [SEMI-PRO] ████████░░ 80%  |  [BASIC] ████░░░░░░ 40%',
    ],
  };

  const assetsData = {
    title: '[02 // ASSETS / LICENSE]',
    tag: 'tag-asset',
    lines: [
      '',
      '<span class="dim">LOCAL ASTRO ASSETS DIRECTORY — VERIFIED & MOUNTED</span>',
      '',
      '<span class="highlight">Location:</span> <span class="dim">/assets/ (public mount)</span>',
      '<span class="highlight">Status:</span>  <span class="success">VERIFIED & MOUNTED</span>',
      '',
    ],
  };

  const linksData = {
    title: '[03 // LINKS]',
    tag: 'tag-prof',
    lines: ['', '<span class="dim">EXTERNAL NODES</span>', ''],
  };

  function runBootSequence() {
    const body = getTerminalBody();
    body.innerHTML = '';
    let idx = 0;
    let lineIndex = 0;
    function nextLine() {
      if (idx >= bootSequence.length) {
        addPrompt();
        return;
      }
      const entry = bootSequence[idx];
      idx++;
      if (entry.skip) {
        setTimeout(nextLine, entry.delay || 100);
        return;
      }
      appendToBody(createLine(entry.text, entry.cls, lineIndex));
      lineIndex++;
      setTimeout(nextLine, entry.delay || 300);
    }
    nextLine();
  }

  function addPrompt() {
    appendToBody(
      createEl(
        'div',
        'line',
        `<span class="dim">[${formatTime()}]</span> ` +
          `<span class="input-prompt">fajri$</span> <span class="dim">${HINT}</span>`,
      ),
    );
  }

  function clearOutput() {
    getTerminalBody().innerHTML = '';
    addPrompt();
  }

  function showHelp() {
    appendLine('<span class="success">[OK]</span> Available commands:', 'tag-ok');
    for (const command of commands) {
      if (command.help) appendLine(`  ${command.usage} — ${command.help}`);
    }
  }

  function showSkills() {
    appendLine(skillsData.title, skillsData.tag);
    appendDivider();
    for (const line of skillsData.lines) appendLine(line);

    const isGui = isGuiMode();
    SKILLS.forEach((skill, i) => {
      setTimeout(() => {
        appendSkillBar({
          name: skill.shortName,
          level: skill.level,
          pct: skill.pct,
          fillClass: isGui ? skill.guiClass : undefined,
          fillColor: isGui ? undefined : skill.cliColor,
        });
      }, i * 400);
    });
  }

  function showAssets() {
    appendLine(assetsData.title, assetsData.tag);
    appendDivider();
    for (const line of assetsData.lines) appendLine(line);

    setTimeout(() => {
      appendGrid('asset-grid', ASSET_FILES, (asset) =>
        createEl(
          'div',
          'asset-item',
          `<span class="asset-icon">${asset.emoji}</span>` +
            `<span class="asset-name">${asset.file}</span>` +
            `<span class="asset-size dim">${asset.size}</span>`,
        ),
      );

      setTimeout(() => {
        appendLine(
          '<span class="dim">💡 Files served from public/assets/ — inspect on GitHub: ' +
            `<a href="${LINKS_BY_NAME.GitHub.url}" class="highlight">github.com/${PROFILE.username}</a></span>`,
        );
      }, 200);
    }, 100);
  }

  function showLinks() {
    appendLine(linksData.title, linksData.tag);
    appendDivider();
    for (const line of linksData.lines) appendLine(line);

    setTimeout(() => {
      appendGrid('link-grid', SOCIAL_LINKS, (link) => {
        const item = createEl(
          'a',
          'link-item',
          `<span class="link-icon">${link.emoji}</span>` +
            `<span class="link-text">${link.name}</span>` +
            `<span class="link-url dim">${new URL(link.url).hostname}</span>`,
        );
        item.href = link.url;
        item.target = '_blank';
        item.rel = 'noopener noreferrer';
        return item;
      });

      setTimeout(() => {
        appendLine(
          '<span class="dim">🔗 <span class="makan">Check out my YouTube ' +
            '@fajriaep580 for After Effects work!</span></span>',
        );
      }, 200);
    }, 100);
  }

  function showProfile() {
    appendLine('<span class="highlight-purple">[04 // PROFILE]</span>', 'tag-prof');
    appendDivider();

    const rows = TERMINAL_INFO_ROWS.map((row) => {
      const badge = row.badge
        ? ` <span class="badge ${row.badge.className}">${row.badge.text}</span>`
        : '';
      return (
        `<div><span class="label">${row.label}</span><br/>` +
        `<span class="value${row.valueClass ? ` ${row.valueClass}` : ''}">${row.value}</span>${badge}</div>`
      );
    }).join('');

    appendToBody(
      createEl(
        'div',
        'profile-grid',
        `<img src="${PROFILE.avatar}" alt="${PROFILE.fullName}" class="profile-pic" ` +
          'width="120" height="120" loading="eager" decoding="async" />' +
          `<div class="profile-details">${rows}</div>`,
      ),
    );
  }

  function showMakan() {
    const foods = ['🍜 Ramen', '🍕 Pizza', '🍔 Burger', '🍣 Sushi', '🌮 Tacos', '🍝 Pasta', '🍗 Fried Chicken', '🥘 Nasi Goreng', '🍩 Donuts', '🍰 Cake'];
    const randomFood = foods[Math.floor(Math.random() * foods.length)];
    appendLine(
      `[MAKUAN AGENT] Fajri's current makan craving: <span class="makan">${randomFood}</span>`,
      'tag-warn',
    );
    appendLine(
      '<span class="dim">Pro tip: Ask him about the best warung in ' +
        `<span class="highlight">${PROFILE.location.split(',')[0]}</span> — he knows the spots.</span>`,
      'dim',
    );
  }

  function showPortStatus() {
    appendLine(`[PORT ${PROFILE.port}] <span class="success">ACTIVE</span> // STATUS: 200 OK`, 'tag-ok');
    appendLine(
      `<span class="dim">Listening on: <span class="highlight">localhost:${PROFILE.port}</span></span>`,
      'dim',
    );
    appendLine(
      '<span class="dim">TLS: <span class="success">ENABLED</span> | Engine: ' +
        '<span class="highlight-cyan">ASTRO</span> | Mode: <span class="highlight-purple">SERVER</span></span>',
      'dim',
    );
  }

  /** Command registry: aliases, help text and handler in one place. */
  const commands = [
    { usage: '[1] SKILLS', help: 'View tech stack & proficiency', aliases: ['1', 'skills', 'skill'], run: showSkills },
    { usage: '[2] ASSETS/LICENSE', help: 'Browse local Astro assets', aliases: ['2', 'assets', 'license', 'cert'], run: showAssets },
    { usage: '[3] LINKS', help: 'Social & GitHub nodes', aliases: ['3', 'links', 'social', 'connect'], run: showLinks },
    { usage: '[4] PROFILE', help: "Fajri's profile card", aliases: ['4', 'profile', 'about', 'whoami'], run: showProfile },
    { usage: '[makan]', help: 'Personal hobby (food!)', aliases: ['makan', 'hobby', 'eat'], run: showMakan },
    { usage: '[clear]', help: 'Clear terminal', aliases: ['clear', 'cls'], run: clearOutput, silent: true },
    { usage: '[help]', help: 'This help', aliases: ['', 'help', 'h', '?'], run: showHelp },
    { usage: '[port]', aliases: [PROFILE.port, 'port'], run: showPortStatus },
  ];

  function isGuiMode() {
    return document.getElementById('fajri-terminal')?.dataset.mode === 'gui';
  }

  function handleCommand(cmd) {
    appendToBody(
      createEl('div', 'line', `<span class="highlight-pink">fajri$</span> ${escapeHtml(cmd)}`),
    );

    const normalized = cmd.trim().toLowerCase();
    const command = commands.find((entry) => entry.aliases.includes(normalized));

    if (!command) {
      appendLine(`[ERROR] Unknown command: <span class="highlight-pink">${escapeHtml(cmd)}</span>`, 'tag-warn');
      appendLine(
        '<span class="dim">Available: [1] SKILLS, [2] ASSETS, [3] LINKS, [4] PROFILE, [help], [makan], [clear]</span>',
        'dim',
      );
      addPrompt();
      return;
    }

    command.run();
    if (!command.silent) addPrompt();
  }

  document.addEventListener('DOMContentLoaded', function() {
    runBootSequence();

    const input = document.getElementById('terminal-input');
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        const cmd = input.value;
        input.value = '';
        if (cmd.trim()) { handleCommand(cmd); }
      }
      if (e.key === 'Tab') { e.preventDefault(); input.value = 'help'; }
    });

    // Mode toggle (Terminal <-> Neubrutalist GUI)
    const modeToggle = document.getElementById('mode-toggle');
    const guiModeToggle = document.getElementById('gui-mode-toggle');
    const root = document.getElementById('fajri-terminal');

    function toggleMode() {
      const wasGui = root.dataset.mode === 'gui';
      root.dataset.mode = wasGui ? 'terminal' : 'gui';
      if (modeToggle) {
        modeToggle.classList.toggle('active', !wasGui);
        const icon = modeToggle.querySelector('.mode-icon');
        const label = modeToggle.querySelector('.mode-label');
        if (icon) icon.textContent = !wasGui ? '▣' : '□';
        if (label) label.textContent = !wasGui ? 'TERM' : 'GUI';
      }
    }

    if (modeToggle) modeToggle.addEventListener('click', toggleMode);
    if (guiModeToggle) guiModeToggle.addEventListener('click', toggleMode);

    // Parallax Scroll & Mousemove Effects for GUI Mode
    const guiContainer = document.getElementById('neubrutalism-gui');
    if (guiContainer) {
      /** Applies `transform` to every `[data-speed]` element inside `scope`. */
      const applyParallax = (scope, toTransform) => {
        if (!isGuiMode()) return;
        scope.querySelectorAll('[data-speed]').forEach((el) => {
          const speed = parseFloat(el.getAttribute('data-speed'));
          el.style.transform = toTransform(Number.isNaN(speed) ? 0.1 : speed);
        });
      };

      // 1. Mouse move parallax on the floating background shapes
      guiContainer.addEventListener('mousemove', function(e) {
        const rect = guiContainer.getBoundingClientRect();
        const mouseX = e.clientX - rect.left - rect.width / 2;
        const mouseY = e.clientY - rect.top - rect.height / 2;
        applyParallax(
          guiContainer.querySelector('.gui-parallax-bg') || guiContainer,
          (speed) =>
            `translate3d(${mouseX * speed * 0.4}px, ${mouseY * speed * 0.4}px, 0) ` +
            `rotate(${mouseX * 0.02}deg)`,
        );
      });

      // 2. Scroll Parallax
      window.addEventListener('scroll', function() {
        const scrolled = window.scrollY;
        applyParallax(guiContainer, (speed) => `translate3d(0, ${-(scrolled * speed)}px, 0)`);
      });
    }

    input.focus();
  });

  // --- p5.js Interactive Dual-Mode Canvas (Cyberpunk CLI & Neubrutalism GUI) ---
  if (typeof window !== 'undefined') {
    const initP5 = () => {
      if (!window.p5) return;
      new window.p5(p => {
        let particles = [];
        const particleCount = 40;

        p.setup = () => {
          const canvas = p.createCanvas(window.innerWidth, window.innerHeight);
          canvas.parent('p5-bg-canvas');
          p.pixelDensity(1);

          for (let i = 0; i < particleCount; i++) {
            particles.push({
              x: p.random(p.width),
              y: p.random(p.height),
              vx: p.random(-0.7, 0.7),
              vy: p.random(-0.7, 0.7),
              size: p.random(8, 20),
              shapeType: Math.floor(p.random(0, 3)),
              colorIdx: Math.floor(p.random(0, 5)),
              angle: p.random(p.TWO_PI),
              spin: p.random(-0.02, 0.02)
            });
          }
        };

        p.draw = () => {
          p.clear();
          const isGui = isGuiMode();

          const guiColors = ['#FFD23F', '#FF6B6B', '#74B9FF', '#B8A9FA', '#88D498'];
          const cliColors = ['rgba(0, 240, 255, 0.5)', 'rgba(255, 46, 149, 0.5)', 'rgba(138, 43, 226, 0.5)'];

          particles.forEach((pt, i) => {
            pt.x += pt.vx;
            pt.y += pt.vy;
            pt.angle += pt.spin;

            if (pt.x < 0 || pt.x > p.width) pt.vx *= -1;
            if (pt.y < 0 || pt.y > p.height) pt.vy *= -1;

            // Interactive mouse repulsion
            let dx = p.mouseX - pt.x;
            let dy = p.mouseY - pt.y;
            let dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 130 && dist > 0) {
              pt.x -= (dx / dist) * 2.5;
              pt.y -= (dy / dist) * 2.5;
            }

            p.push();
            p.translate(pt.x, pt.y);
            p.rotate(pt.angle);

            if (isGui) {
              // Neubrutalism mode: bold black outline, solid vibrant shapes
              p.stroke(0);
              p.strokeWeight(2.5);
              p.fill(guiColors[pt.colorIdx % guiColors.length]);

              if (pt.shapeType === 0) {
                p.circle(0, 0, pt.size * 1.3);
              } else if (pt.shapeType === 1) {
                p.rectMode(p.CENTER);
                p.rect(0, 0, pt.size * 1.2, pt.size * 1.2);
              } else {
                p.triangle(-pt.size * 0.8, pt.size * 0.8, pt.size * 0.8, pt.size * 0.8, 0, -pt.size * 0.8);
              }
            } else {
              // Cyberpunk CLI mode: glowing connecting data nodes
              p.noStroke();
              p.fill(cliColors[pt.colorIdx % cliColors.length]);
              p.circle(0, 0, pt.size * 0.55);

              // Connect nearby nodes with glowing line segments
              for (let j = i + 1; j < particles.length; j++) {
                let other = particles[j];
                let d = p.dist(pt.x, pt.y, other.x, other.y);
                if (d < 120) {
                  p.stroke('rgba(0, 240, 255, ' + (0.3 * (1 - d / 120)) + ')');
                  p.strokeWeight(1);
                  p.line(0, 0, other.x - pt.x, other.y - pt.y);
                }
              }
            }
            p.pop();
          });
        };

        p.windowResized = () => p.resizeCanvas(window.innerWidth, window.innerHeight);
      });
    };

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initP5, 200);
    } else {
      window.addEventListener('DOMContentLoaded', () => setTimeout(initP5, 200));
    }
  }
</script>
