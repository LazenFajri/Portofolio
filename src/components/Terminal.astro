---
import { Code } from 'astro/components';
import { Image } from 'astro:assets';
---

<div id="p5-bg-canvas"></div>
<div id="fajri-terminal" class="terminal-root" data-mode="terminal">
  <div class="terminal-scanlines"></div>
  <div class="terminal-hud-glow"></div>

  <div class="terminal-header">
    <div class="terminal-window-controls">
      <span class="control-btn" data-color="#ff5f56"></span>
      <span class="control-btn" data-color="#ffbd2e"></span>
      <span class="control-btn" data-color="#27c93f"></span>
    </div>
    <span class="terminal-title">
      <span class="pulse-dot"></span> fajri@station:~ (zsh)
    </span>
    <button id="mode-toggle" class="mode-toggle" title="Toggle Terminal / Neubrutalist GUI">
      <span class="mode-icon">□</span>
      <span class="mode-label">GUI</span>
    </button>
  </div>

  <div class="terminal-body" id="terminal-body">
    <!-- typed line-by-line via JS -->
  </div>

  <div class="terminal-input-zone">
    <span class="input-prompt">fajri@station:~$</span>
    <input type="text" id="terminal-input" class="terminal-input" autocomplete="off" spellcheck="false"
           placeholder="Type [1] SKILLS | [2] ASSETS | [3] LINKS | [4] PROFILE | [help]" />
  </div>

  <div class="terminal-status">
    <span class="status-item"><span class="status-dot"></span> NODE: <span class="highlight">localhost:4321</span></span>
    <span class="status-item">SHELL: <span class="highlight success">ZSH / ASTRO</span></span>
    <span class="status-item">SECURITY: <span class="highlight">TLS 1.3</span></span>
    <span class="status-item">STATUS: <span class="highlight success">ONLINE</span></span>
  </div>

  <!-- GUI Mode Content (Modern Neubrutalism Portfolio Website) -->
  <div id="neubrutalism-gui" class="gui-container">
    <header class="gui-header">
      <div class="gui-brand">
        <img src="/assets/MyLogo.png" alt="UDINUS Logo" class="gui-brand-logo" width="36" height="36" />
        <div class="gui-brand-text">
          <span class="gui-brand-title">MUHAMMAD FAJRI SETYAWAN</span>
          <span class="gui-brand-sub">UDINUS • TEKNIK INFORMATIKA 2026</span>
        </div>
      </div>
      <div class="gui-nav-actions">
        <span class="gui-status-pill"><span class="material-symbols-outlined nav-icon">bolt</span> FAJRI-OS ONLINE</span>
        <button id="gui-mode-toggle" class="gui-toggle-btn">
          <span class="material-symbols-outlined gui-btn-icon">terminal</span> SWITCH TO TERMINAL
        </button>
      </div>
    </header>

    <!-- Parallax background floating shapes -->
    <div class="gui-parallax-bg">
      <div class="parallax-shape shape-1" data-speed="0.15"></div>
      <div class="parallax-shape shape-2" data-speed="-0.2"></div>
      <div class="parallax-shape shape-3" data-speed="0.25"></div>
    </div>

    <section class="gui-hero">
      <div class="gui-hero-text">
        <div class="gui-badge-row">
          <span class="nb-badge nb-badge-yellow"><span class="material-symbols-outlined badge-icon">school</span> UDINUS 2026</span>
          <span class="nb-badge nb-badge-coral"><span class="material-symbols-outlined badge-icon">movie</span> AFTER EFFECTS</span>
          <span class="nb-badge nb-badge-sky"><span class="material-symbols-outlined badge-icon">smart_toy</span> HERMES AGENT</span>
        </div>
        <h1 class="gui-hero-title">CREATIVE CODER & MOTION DESIGNER</h1>
        <p class="gui-hero-desc">
          Halo! Saya <strong>Muhammad Fajri Setyawan</strong> (@LazenFajri), mahasiswa Teknik Informatika 
          <strong>Universitas Dian Nuswantoro (UDINUS)</strong> Semarang & alumni SMK Negeri 7 Semarang. 
          Spesialisasi di bidang video editing After Effects, prompt engineering AI agent, dan web development.
        </p>
        <div class="gui-hero-actions">
          <a href="#gui-profile" class="nb-btn nb-btn-coral"><span class="material-symbols-outlined btn-icon">person</span> Profil</a>
          <a href="#gui-skills" class="nb-btn nb-btn-yellow"><span class="material-symbols-outlined btn-icon">electric_bolt</span> Skill</a>
          <a href="#gui-assets" class="nb-btn nb-btn-sky"><span class="material-symbols-outlined btn-icon">verified</span> Lisensi</a>
          <a href="https://youtube.com/@fajriaep580" target="_blank" rel="noopener" class="nb-btn nb-btn-lavender"><span class="material-symbols-outlined btn-icon">play_circle</span> YouTube</a>
        </div>
      </div>
      <div class="gui-hero-avatar-box" data-speed="0.08">
        <div class="gui-avatar-card">
          <img src="/assets/Muhammad Fajri Setyawan.png" alt="Muhammad Fajri Setyawan" class="gui-avatar-img" width="260" height="260" loading="eager" decoding="async" />
          <div class="gui-avatar-caption">
            <strong>Muhammad Fajri Setyawan</strong>
            <span>@LazenFajri • Semarang, ID</span>
          </div>
        </div>
      </div>
    </section>

    <div class="gui-grid">
      <section id="gui-profile" class="nb-card nb-card-yellow" data-speed="0.05">
        <div class="nb-card-header">
          <h2><span class="material-symbols-outlined section-icon">badge</span> INFORMASI DIRI</h2>
          <span class="nb-card-tag">PROFILE</span>
        </div>
        <div class="gui-info-list">
          <div class="gui-info-item">
            <span class="info-label">NAMA LENGKAP</span>
            <span class="info-val">Muhammad Fajri Setyawan</span>
          </div>
          <div class="gui-info-item">
            <span class="info-label">USERNAME</span>
            <span class="info-val">LazenFajri</span>
          </div>
          <div class="gui-info-item">
            <span class="info-label">STATUS</span>
            <span class="info-val">Mahasiswa Baru FIK (UDINUS)</span>
          </div>
          <div class="gui-info-item">
            <span class="info-label">INSTITUSI</span>
            <span class="info-val">Universitas Dian Nuswantoro</span>
          </div>
          <div class="gui-info-item">
            <span class="info-label">PRODI</span>
            <span class="info-val">Teknik Informatika (S1)</span>
          </div>
          <div class="gui-info-item">
            <span class="info-label">PENDIDIKAN DAHULU</span>
            <span class="info-val">SMK Negeri 7 Semarang</span>
          </div>
          <div class="gui-info-item">
            <span class="info-label">HOBI & FAVORIT</span>
            <span class="info-val"><span class="material-symbols-outlined inline-icon">restaurant</span> Kulineran & Makan</span>
          </div>
        </div>
      </section>

      <section id="gui-skills" class="nb-card nb-card-lavender" data-speed="-0.05">
        <div class="nb-card-header">
          <h2><span class="material-symbols-outlined section-icon">psychology</span> SKILLS & EXPERTISE</h2>
          <span class="nb-card-tag">SKILLS</span>
        </div>
        <div class="gui-skills-container">
          <div class="gui-skill-item">
            <div class="gui-skill-meta">
              <span><span class="material-symbols-outlined skill-icon">movie</span> After Effects Video Editing</span>
              <strong>[SEMI-PRO] 80%</strong>
            </div>
            <div class="gui-progress-bar">
              <div class="gui-progress-fill coral" style="width: 80%;"></div>
            </div>
          </div>
          <div class="gui-skill-item">
            <div class="gui-skill-meta">
              <span><span class="material-symbols-outlined skill-icon">smart_toy</span> Agent Prompting</span>
              <strong>[SEMI-PRO] 80%</strong>
            </div>
            <div class="gui-progress-bar">
              <div class="gui-progress-fill sky" style="width: 80%;"></div>
            </div>
          </div>
          <div class="gui-skill-item">
            <div class="gui-skill-meta">
              <span><span class="material-symbols-outlined skill-icon">code</span> Coding Fundamentals</span>
              <strong>[BASIC] 40%</strong>
            </div>
            <div class="gui-progress-bar">
              <div class="gui-progress-fill yellow" style="width: 40%;"></div>
            </div>
          </div>      
        </div>
      </section>

      <section id="gui-assets" class="nb-card nb-card-sky" data-speed="0.08">
        <div class="nb-card-header">
          <h2><span class="material-symbols-outlined section-icon">workspace_premium</span> SERTIFIKAT & LISENSI</h2>
          <span class="nb-card-tag">DOWNLOADS</span>
        </div>
        <div class="gui-asset-list">
          <a href="/assets/CCNA License.pdf" target="_blank" class="gui-asset-link">
            <span class="material-symbols-outlined asset-icon">history_edu</span>
            <div class="asset-details">
              <strong>CCNA License</strong>
              <small>Cisco Certified Network Associate (PDF)</small>
            </div>
            <span class="nb-mini-btn">UNDUH</span>
          </a>
          <a href="/assets/Java Fundametals license.pdf" target="_blank" class="gui-asset-link">
            <span class="material-symbols-outlined asset-icon">terminal</span>
            <div class="asset-details">
              <strong>Java Fundamentals License</strong>
              <small>Oracle / Java Certification (PDF)</small>
            </div>
            <span class="nb-mini-btn">UNDUH</span>
          </a>
          <a href="/assets/PC, Hardware, and Software License.pdf" target="_blank" class="gui-asset-link">
            <span class="material-symbols-outlined asset-icon">build_circle</span>
            <div class="asset-details">
              <strong>PC, Hardware, & Software License</strong>
              <small>IT Infrastructure & Hardware (PDF)</small>
            </div>
            <span class="nb-mini-btn">UNDUH</span>
          </a>
        </div>
      </section>

      <section id="gui-links" class="nb-card nb-card-coral" data-speed="-0.08">
        <div class="nb-card-header">
          <h2><span class="material-symbols-outlined section-icon">share</span> MEDIA SOSIAL & PORTAL</h2>
          <span class="nb-card-tag">CONNECT</span>
        </div>
        <div class="gui-link-grid">
          <a href="https://youtube.com/@fajriaep580" target="_blank" rel="noopener" class="gui-social-btn">
            <img src="/assets/Youtube_logo.png" alt="YouTube" width="22" height="22" />
            <span>YouTube (@fajriaep580)</span>
          </a>
          <a href="https://github.com/LazenFajri" target="_blank" rel="noopener" class="gui-social-btn">
            <img src="/assets/Octicons-mark-github.svg" alt="GitHub" width="22" height="22" />
            <span>GitHub (LazenFajri)</span>
          </a>
          <a href="https://www.linkedin.com/in/muhammad-fajri-setyawan-51100726b" target="_blank" rel="noopener" class="gui-social-btn">
            <img src="/assets/LinkedIn_icon.svg" alt="LinkedIn" width="22" height="22" />
            <span>LinkedIn (Fajri Setyawan)</span>
          </a>
        </div>
      </section>

      <section id="gui-snake" class="nb-card nb-card-snake" data-speed="0.04">
        <div class="nb-card-header">
          <h2><span class="material-symbols-outlined section-icon">conversion_path</span> GITHUB CONTRIBUTIONS</h2>
          <span class="nb-card-tag">ACTIVITY</span>
        </div>
        <div class="gui-snake-wrap">
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset="https://raw.githubusercontent.com/LazenFajri/Portofolio/output/github-contribution-grid-snake-dark.svg" />
            <img
              src="https://raw.githubusercontent.com/LazenFajri/Portofolio/output/github-contribution-grid-snake.svg"
              alt="GitHub Contribution Snake Animation LazenFajri"
              class="gui-snake-img"
              loading="lazy"
              onerror="this.closest('.gui-snake-wrap').innerHTML='<p class=\'snake-pending\'>🐍 Snake animation akan muncul setelah GitHub Actions pertama kali berjalan.</p>'"
            />
          </picture>
        </div>
      </section>
    </div>
  </div>
</div>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&family=JetBrains+Mono:wght@400;500;600;700&family=Fira+Code:wght@400;500;600;700&display=swap');

  :root {
    /* Terminal colors (Authentic Modern Unix / Ghost CLI) */
    --bg: #090d13;
    --bg-card: #0d1117;
    --bg-card-subtle: #161b22;
    --text-primary: #e6edf3;
    --text-dim: #7d8590;
    --text-dimmer: #484f58;
    --accent-emerald: #3fb950;
    --accent-blue: #58a6ff;
    --accent-cyan: #39c5bb;
    --accent-amber: #d29922;
    --accent-coral: #f85149;
    --border: #21262d;
    --border-bright: #30363d;
    --border-active: #3fb950;
    --glow-subtle: 0 0 12px rgba(63, 185, 80, 0.15);

    /* Neubrutalism tokens (Dark Mode High Contrast) */
    --nb-black: #000000;
    --nb-white: #0a0d14;
    --nb-border-light: #384252;
    --nb-text-main: #f0f6fc;
    --nb-text-muted: #9ba7b6;
    --nb-yellow: #f59e0b;
    --nb-coral: #ef4444;
    --nb-sky: #38bdf8;
    --nb-green: #22c55e;
    --nb-orange: #f97316;
    --nb-lavender: #a855f7;

    --nb-stroke: 2px;
    --nb-radius: 8px;
    --nb-shadow-sm: 3px 3px 0 0 #000000;
    --nb-shadow-md: 5px 5px 0 0 #000000;
    --nb-shadow-lg: 8px 8px 0 0 #000000;

    /* Fonts */
    --font-display: 'Syne', 'Space Grotesk', sans-serif;
    --font-heading: 'Space Grotesk', 'Syne', sans-serif;
    --font-body: 'Inter', 'Space Mono', monospace;
    --font-mono: 'JetBrains Mono', 'Fira Code', 'Space Mono', monospace;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #06090e;
    min-height: 100vh;
    font-family: var(--font-mono);
    overflow-x: hidden;
    color: var(--text-primary);
    line-height: 1.6;
  }

  /* ============================================================
     TERMINAL MODE (Authentic Modern Unix Ghost CLI)
     ============================================================ */

  .terminal-root {
    position: relative;
    width: 100%;
    max-width: 920px;
    min-height: 540px;
    margin: 2.5rem auto;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);
    overflow: hidden;
    backdrop-filter: blur(8px);
  }

  /* Subtle vignette instead of noisy scanlines */
  .terminal-scanlines {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 65%, rgba(0, 0, 0, 0.4) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .terminal-hud-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  /* Terminal Header with authentic window controls */
  .terminal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 1.2rem;
    background: #161b22;
    border-bottom: 1px solid var(--border);
    z-index: 2;
    position: relative;
  }

  /* Mode Toggles */
  .mode-toggle {
    display: flex; align-items: center; gap: 0.4rem;
    background: rgba(255,255,255,0.05); border: 1px solid var(--border);
    padding: 0.35rem 0.6rem; border-radius: 4px; color: var(--text-dim);
    font-size: 0.75rem; cursor: pointer; transition: all 0.2s;
    font-family: var(--font-mono);
  }
  .mode-toggle:hover { background: rgba(255,255,255,0.1); color: var(--text-primary); }
  .mode-toggle.active { background: rgba(63, 185, 80, 0.15); color: var(--accent-emerald); border-color: rgba(63, 185, 80, 0.3); }

  .gui-toggle-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--nb-white); border: 2px solid var(--nb-black);
    padding: 0.5rem 1rem; color: var(--nb-black); font-weight: 700;
    font-family: var(--font-body); cursor: pointer;
    box-shadow: 3px 3px 0 0 #000000;
    transition: transform 0.1s, box-shadow 0.1s;
    font-size: 0.85rem;
  }
  .gui-toggle-btn:active {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 0 #000000;
  }

  .terminal-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-dim);
    letter-spacing: 0.5px;
    font-family: var(--font-mono);
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-emerald);
    box-shadow: 0 0 6px var(--accent-emerald);
    display: inline-block;
  }

  .dim { color: var(--text-dim); font-weight: 400; }

  .terminal-window-controls {
    display: flex;
    gap: 7px;
  }

  .control-btn {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    opacity: 0.85;
    transition: opacity 0.2s;
  }
  .control-btn:hover { opacity: 1; }
  .control-btn:nth-child(1) { background: #ff5f56; }
  .control-btn:nth-child(2) { background: #ffbd2e; }
  .control-btn:nth-child(3) { background: #27c93f; }

  /* Terminal body */
  .terminal-body {
    padding: 1.4rem 1.6rem 1rem;
    min-height: 400px;
    font-size: 0.84rem;
    line-height: 1.55;
    z-index: 2;
    position: relative;
    overflow-y: auto;
    font-family: var(--font-mono);
  }

  .terminal-body::-webkit-scrollbar { width: 6px; }
  .terminal-body::-webkit-scrollbar-track { background: var(--bg-card); }
  .terminal-body::-webkit-scrollbar-thumb { background: var(--border-bright); border-radius: 3px; }

  /* Output lines */
  .line {
    margin-bottom: 0.25rem;
    opacity: 0;
    transform: translateY(4px);
    animation: fadeInUp 0.25s forwards;
    word-break: break-word;
  }

  @keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }

  .line-delay-0 { animation-delay: 0ms; }
  .line-delay-1 { animation-delay: 50ms; }
  .line-delay-2 { animation-delay: 100ms; }
  .line-delay-3 { animation-delay: 150ms; }
  .line-delay-4 { animation-delay: 200ms; }
  .line-delay-5 { animation-delay: 250ms; }
  .line-delay-6 { animation-delay: 300ms; }
  .line-delay-7 { animation-delay: 350ms; }
  .line-delay-8 { animation-delay: 400ms; }
  .line-delay-9 { animation-delay: 450ms; }
  .line-delay-10 { animation-delay: 500ms; }
  .line-delay-11 { animation-delay: 550ms; }
  .line-delay-12 { animation-delay: 600ms; }
  .line-delay-13 { animation-delay: 650ms; }
  .line-delay-14 { animation-delay: 700ms; }
  .line-delay-15 { animation-delay: 750ms; }

  /* Tags & Badges */
  .tag {
    display: inline-block;
    padding: 0.08rem 0.4rem;
    border-radius: 3px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-right: 0.4rem;
  }
  .tag-sys { background: rgba(88, 166, 255, 0.12); color: var(--accent-blue); border: 1px solid rgba(88, 166, 255, 0.25); }
  .tag-prof { background: rgba(57, 197, 187, 0.12); color: var(--accent-cyan); border: 1px solid rgba(57, 197, 187, 0.25); }
  .tag-asset { background: rgba(210, 153, 34, 0.12); color: var(--accent-amber); border: 1px solid rgba(210, 153, 34, 0.25); }
  .tag-ok { background: rgba(63, 185, 80, 0.12); color: var(--accent-emerald); border: 1px solid rgba(63, 185, 80, 0.25); }
  .tag-warn { background: rgba(210, 153, 34, 0.12); color: var(--accent-amber); border: 1px solid rgba(210, 153, 34, 0.25); }

  /* Clean Terminal Accents */
  .highlight { color: #f0f6fc; font-weight: 600; }
  .highlight-blue { color: var(--accent-blue); }
  .highlight-emerald { color: var(--accent-emerald); }
  .highlight-cyan { color: var(--accent-cyan); }
  .highlight-amber { color: var(--accent-amber); }
  .success { color: var(--accent-emerald); }
  .warn { color: var(--accent-amber); }
  .dim { color: var(--text-dim); }
  .makan { color: var(--accent-amber); }

  .divider {
    color: var(--border-bright);
    margin: 0.6rem 0;
    font-family: var(--font-mono);
    opacity: 0.6;
  }

  .ascii-box {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.6rem 0.8rem;
    margin: 0.6rem 0;
    font-size: 0.8rem;
    background: var(--bg-card-subtle);
  }

  /* Skill bar (clean modern terminal style) */
  .skill-bar { margin: 0.4rem 0; max-width: 580px; }
  .skill-name {
    display: flex; justify-content: space-between;
    margin-bottom: 0.2rem; font-size: 0.78rem;
  }
  .skill-name span { color: var(--text-primary); font-weight: 500; }
  .skill-name .level-label { color: var(--text-dim); }
  .skill-track {
    height: 6px; background: rgba(255, 255, 255, 0.06);
    border-radius: 3px; overflow: hidden; position: relative;
    border: 1px solid var(--border);
  }
  .skill-fill {
    height: 100%; border-radius: 2px;
    background-color: var(--accent-emerald);
    transition: width 0.7s ease;
  }

  /* Asset Grid */
  .asset-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem; margin: 0.6rem 0;
  }
  .asset-item {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.45rem 0.7rem; border-radius: 6px;
    background: var(--bg-card-subtle); border: 1px solid var(--border);
    font-size: 0.76rem; transition: all 0.2s; text-decoration: none;
  }
  .asset-item:hover {
    background: #1f242c; border-color: var(--border-bright);
    transform: translateY(-1px);
  }
  .asset-icon-box {
    display: flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; flex-shrink: 0;
    border-radius: 4px; background: rgba(255, 255, 255, 0.04);
  }
  .asset-icon-box img { width: 18px; height: 18px; object-fit: contain; }
  .asset-icon-box svg { width: 16px; height: 16px; fill: currentColor; }
  .asset-meta { display: flex; flex-direction: column; overflow: hidden; }
  .asset-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-primary); font-weight: 500; }
  .asset-size { color: var(--text-dim); font-size: 0.68rem; }

  /* Links Grid */
  .link-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem; margin: 0.6rem 0;
  }
  .link-item {
    display: flex; align-items: center; gap: 0.65rem;
    padding: 0.5rem 0.75rem; border-radius: 6px;
    background: var(--bg-card-subtle); border: 1px solid var(--border);
    font-size: 0.78rem; transition: all 0.2s; text-decoration: none;
  }
  .link-item:hover {
    background: #1f242c; border-color: var(--accent-blue);
    transform: translateY(-1px);
  }
  .link-icon-box {
    display: flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; flex-shrink: 0;
    border-radius: 4px; background: rgba(255, 255, 255, 0.04);
  }
  .link-icon-box img { width: 18px; height: 18px; object-fit: contain; }
  .link-text { color: var(--text-primary); font-weight: 600; flex: 1; }
  .link-url { color: var(--text-dim); font-size: 0.7rem; }

  /* Terminal Input Zone */
  .terminal-input-zone {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.7rem 1.5rem;
    background: #161b22;
    border-top: 1px solid var(--border);
    z-index: 2; position: relative;
  }

  .input-prompt {
    color: var(--accent-emerald);
    font-weight: 600;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .terminal-input {
    flex: 1; background: transparent; border: none;
    color: var(--text-primary);
    font-family: var(--font-mono); font-size: 0.85rem;
    outline: none; caret-color: var(--accent-emerald);
  }
  .terminal-input::placeholder { color: var(--text-dimmer); }

  /* Status Bar */
  .terminal-status {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.4rem 1.2rem;
    background: #0d1117;
    border-top: 1px solid var(--border);
    font-size: 0.72rem; z-index: 2; position: relative;
    flex-wrap: wrap; gap: 0.5rem;
    color: var(--text-dim);
  }
  .status-item { display: flex; align-items: center; gap: 0.3rem; }
  .status-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent-emerald); display: inline-block;
  }

  /* Profile card (terminal) */
  .profile-grid {
    display: flex; gap: 1.2rem;
    margin: 0.8rem 0; align-items: center;
    background: var(--bg-card-subtle);
    padding: 1rem; border-radius: 8px;
    border: 1px solid var(--border);
  }
  .profile-pic {
    width: 72px; height: 72px;
    border-radius: 6px; object-fit: cover;
    border: 1px solid var(--border-bright);
  }
  .profile-details { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.8rem; }
  .profile-details .label { color: var(--text-dim); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; }
  .profile-details .value { color: var(--text-primary); }
  .badge {
    display: inline-block; padding: 0.05rem 0.35rem; border-radius: 3px;
    font-size: 0.65rem; font-weight: 600; letter-spacing: 0.5px;
    margin-left: 0.3rem;
  }
  .badge-student { background: rgba(88, 166, 255, 0.15); color: var(--accent-blue); border: 1px solid rgba(88, 166, 255, 0.3); }
  .badge-coder { background: rgba(63, 185, 80, 0.15); color: var(--accent-emerald); border: 1px solid rgba(63, 185, 80, 0.3); }



  /* ============================================================
     P5.JS BACKGROUND CANVAS
     ============================================================ */

  #p5-bg-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  #p5-bg-canvas canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  /* ============================================================
     NEUBRUTALISM GUI MODE (Modern Portfolio Website)
     ============================================================ */

  #neubrutalism-gui {
    display: none;
    background: var(--nb-white);
    color: var(--nb-black);
    padding: 1.5rem;
    font-family: var(--font-body);
    position: relative;
    overflow: hidden;
  }

  /* Material Symbols styling inside GUI */
  #neubrutalism-gui .material-symbols-outlined {
    font-size: 1.15em;
    vertical-align: middle;
    font-variation-settings: 'FILL' 1, 'wght' 600, 'GRAD' 0, 'opsz' 24;
    display: inline-block;
  }
  .nav-icon { font-size: 1rem !important; margin-right: 3px; color: var(--nb-coral); }
  .gui-btn-icon { font-size: 1.1rem !important; margin-right: 4px; }
  .badge-icon { font-size: 0.9rem !important; margin-right: 3px; }
  .btn-icon { font-size: 1.1rem !important; margin-right: 4px; }
  .section-icon { font-size: 1.25rem !important; margin-right: 6px; color: var(--nb-black); }
  .skill-icon { font-size: 1.05rem !important; margin-right: 4px; }
  .inline-icon { font-size: 1rem !important; margin-right: 4px; color: var(--nb-coral); }
  .asset-icon { font-size: 1.8rem !important; color: var(--nb-black); }

  /* Parallax Background Floating Elements */
  .gui-parallax-bg {
    position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 0;
  }
  .parallax-shape {
    position: absolute; border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 2px 2px 0 0 rgba(0, 0, 0, 0.5); opacity: 0.25;
    transition: transform 0.1s ease-out;
  }
  .shape-1 { top: 8%; right: 4%; width: 60px; height: 60px; background: var(--nb-coral); transform: rotate(15deg); border-radius: 8px; }
  .shape-2 { top: 48%; left: 2%; width: 45px; height: 45px; background: var(--nb-yellow); transform: rotate(-20deg); border-radius: 50%; }
  .shape-3 { bottom: 12%; right: 6%; width: 80px; height: 35px; background: var(--nb-sky); transform: rotate(8deg); border-radius: 8px; }

  .gui-hero, .nb-card { position: relative; z-index: 1; transition: transform 0.15s ease-out, box-shadow 0.15s ease-out; }

  /* Snake Contribution Card */
  .nb-card-snake {
    background: #1a1a2e;
    border: 3px solid var(--nb-black);
    box-shadow: var(--nb-shadow-md);
    padding: 1.2rem;
    grid-column: 1 / -1;
  }
  .nb-card-snake .nb-card-header h2 { color: #88D498; }
  .nb-card-snake .nb-card-tag { background: #88D498; color: #000; }
  .gui-snake-wrap {
    width: 100%;
    overflow: hidden;
    border: 2px solid var(--nb-black);
    background: #0d1117;
    padding: 0.5rem;
    margin-top: 0.75rem;
  }
  .gui-snake-img {
    width: 100%;
    height: auto;
    display: block;
    image-rendering: pixelated;
  }
  .snake-pending {
    text-align: center;
    padding: 2rem 1rem;
    color: #88D498;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    opacity: 0.7;
  }

  /* ============================================================
     RELOAD / ENTRANCE ANIMATIONS (CLI & GUI)
     ============================================================ */

  .terminal-root {
    animation: terminalPop 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes terminalPop {
    0% { opacity: 0; transform: translateY(24px) scale(0.97); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  .terminal-root .terminal-header {
    animation: cliHeaderSlide 0.5s 0.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .terminal-root .terminal-status {
    animation: cliStatusSlide 0.5s 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .terminal-root .terminal-input-zone {
    animation: cliInputSlide 0.5s 0.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes cliHeaderSlide {
    0% { opacity: 0; transform: translateY(-15px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes cliStatusSlide {
    0% { opacity: 0; transform: translateY(15px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes cliInputSlide {
    0% { opacity: 0; transform: scaleX(0.95); }
    100% { opacity: 1; transform: scaleX(1); }
  }

  /* Neubrutalism GUI Staggered Reload Animations */
  .terminal-root[data-mode="gui"] .gui-header {
    animation: nbSlideDown 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .terminal-root[data-mode="gui"] .gui-hero {
    animation: nbHeroPop 0.6s 0.15s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .terminal-root[data-mode="gui"] .nb-badge:nth-child(1) {
    animation: nbBadgeScale 0.4s 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .terminal-root[data-mode="gui"] .nb-badge:nth-child(2) {
    animation: nbBadgeScale 0.4s 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .terminal-root[data-mode="gui"] .nb-badge:nth-child(3) {
    animation: nbBadgeScale 0.4s 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .terminal-root[data-mode="gui"] .gui-hero-title {
    animation: nbTextFade 0.5s 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .terminal-root[data-mode="gui"] .gui-hero-desc {
    animation: nbTextFade 0.5s 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .terminal-root[data-mode="gui"] .nb-btn:nth-child(1) {
    animation: nbBtnBounce 0.4s 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .terminal-root[data-mode="gui"] .nb-btn:nth-child(2) {
    animation: nbBtnBounce 0.4s 0.58s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .terminal-root[data-mode="gui"] .nb-btn:nth-child(3) {
    animation: nbBtnBounce 0.4s 0.66s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .terminal-root[data-mode="gui"] .nb-btn:nth-child(4) {
    animation: nbBtnBounce 0.4s 0.74s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .terminal-root[data-mode="gui"] .gui-avatar-card {
    animation: nbAvatarTilt 0.65s 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .terminal-root[data-mode="gui"] #gui-profile {
    animation: nbCardEntry 0.5s 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .terminal-root[data-mode="gui"] #gui-skills {
    animation: nbCardEntry 0.5s 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .terminal-root[data-mode="gui"] #gui-assets {
    animation: nbCardEntry 0.5s 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .terminal-root[data-mode="gui"] #gui-links {
    animation: nbCardEntry 0.5s 0.75s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .terminal-root[data-mode="gui"] #gui-snake {
    animation: nbCardEntry 0.5s 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes nbSlideDown {
    0% { opacity: 0; transform: translateY(-25px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes nbHeroPop {
    0% { opacity: 0; transform: scale(0.93) translateY(20px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  @keyframes nbBadgeScale {
    0% { opacity: 0; transform: scale(0.4) rotate(-8deg); }
    100% { opacity: 1; transform: scale(1) rotate(0); }
  }

  @keyframes nbTextFade {
    0% { opacity: 0; transform: translateY(12px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes nbBtnBounce {
    0% { opacity: 0; transform: translateY(16px) scale(0.88); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes nbAvatarTilt {
    0% { opacity: 0; transform: scale(0.85) rotate(-6deg) translateY(25px); }
    100% { opacity: 1; transform: scale(1) rotate(0) translateY(0); }
  }

  @keyframes nbCardEntry {
    0% { opacity: 0; transform: translateY(30px) scale(0.96); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  .terminal-root[data-mode="gui"] #neubrutalism-gui {
    display: block;
  }

  .terminal-root[data-mode="gui"] .terminal-scanlines,
  .terminal-root[data-mode="gui"] .terminal-hud-glow,
  .terminal-root[data-mode="gui"] .terminal-header,
  .terminal-root[data-mode="gui"] .terminal-body,
  .terminal-root[data-mode="gui"] .terminal-input-zone,
  .terminal-root[data-mode="gui"] .terminal-status {
    display: none !important;
  }

  .terminal-root[data-mode="gui"] {
    background: var(--nb-white);
    border: var(--nb-stroke) solid var(--nb-black);
    border-radius: var(--nb-radius);
    box-shadow: var(--nb-shadow-lg);
    max-width: 1000px;
    margin: 1.5rem auto;
    min-height: auto;
  }

  /* Neubrutalism Header */
  .gui-header {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: 1.2rem; margin-bottom: 1.5rem;
    border-bottom: 2px solid #2d3748;
    flex-wrap: wrap; gap: 1rem;
  }
  .gui-brand { display: flex; align-items: center; gap: 0.85rem; }
  .gui-brand-logo { border: 2px solid #384252; border-radius: 6px; background: #161b22; object-fit: contain; }
  .gui-brand-text { display: flex; flex-direction: column; }
  .gui-brand-title { font-family: var(--font-heading); font-weight: 800; font-size: 1.1rem; letter-spacing: 0.03em; color: #ffffff; }
  .gui-brand-sub { font-size: 0.72rem; font-family: var(--font-mono); font-weight: 700; color: var(--accent-emerald); }
  .gui-nav-actions { display: flex; align-items: center; gap: 0.8rem; }
  .gui-status-pill {
    background: #1c2331; border: 1px solid #3b4252; color: #38bdf8;
    padding: 0.35rem 0.7rem; font-size: 0.72rem; font-family: var(--font-mono); font-weight: 700;
    border-radius: 6px; box-shadow: 2px 2px 0 0 #000000;
  }
  .gui-toggle-btn {
    background: #ef4444; color: #ffffff;
    border: 2px solid #ffffff;
    border-radius: 6px;
    padding: 0.45rem 1rem; font-family: var(--font-heading); font-weight: 800; font-size: 0.82rem;
    cursor: pointer; box-shadow: 3px 3px 0 0 #000000; transition: all 0.15s;
  }
  .gui-toggle-btn:hover {
    transform: translate(-2px, -2px); box-shadow: 5px 5px 0 0 #000000; background: #dc2626;
  }

  /* Neubrutalism Hero */
  .gui-hero {
    display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 2rem;
    padding: 1.8rem; background: #131924;
    border: 2px solid #2d3748;
    border-radius: 10px;
    box-shadow: 5px 5px 0 0 #000000; margin-bottom: 2rem;
    align-items: center;
  }
  .gui-badge-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .nb-badge {
    border: 1px solid rgba(255, 255, 255, 0.2); padding: 0.25rem 0.65rem; border-radius: 4px;
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    box-shadow: 2px 2px 0 0 #000000;
  }
  .nb-badge-yellow { background: #d97706; color: #ffffff; }
  .nb-badge-coral { background: #dc2626; color: #ffffff; }
  .nb-badge-sky { background: #0284c7; color: #ffffff; }

  .gui-hero-title {
    font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800;
    line-height: 1.15; margin-bottom: 1rem; text-transform: uppercase;
    color: #ffffff; letter-spacing: -0.5px;
  }
  .gui-hero-desc { font-size: 0.95rem; line-height: 1.65; margin-bottom: 1.5rem; color: #cbd5e1; }
  .gui-hero-desc strong { color: #f8fafc; font-weight: 700; }
  .gui-hero-actions { display: flex; gap: 0.65rem; flex-wrap: wrap; }

  .nb-btn {
    display: inline-flex; align-items: center; gap: 0.45rem;
    border: 2px solid #ffffff; padding: 0.55rem 1.05rem; border-radius: 6px;
    font-family: var(--font-heading); font-weight: 800; font-size: 0.85rem; text-decoration: none;
    color: #ffffff; box-shadow: 3px 3px 0 0 #000000; transition: all 0.15s;
    cursor: pointer;
  }
  .nb-btn:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 0 #000000; }
  .nb-btn-coral { background: #ef4444; }
  .nb-btn-coral:hover { background: #dc2626; }
  .nb-btn-yellow { background: #f59e0b; color: #000000; border-color: #000000; }
  .nb-btn-yellow:hover { background: #d97706; }
  .nb-btn-sky { background: #0ea5e9; }
  .nb-btn-sky:hover { background: #0284c7; }
  .nb-btn-lavender { background: #8b5cf6; }
  .nb-btn-lavender:hover { background: #7c3aed; }

  .gui-hero-avatar-box { display: flex; justify-content: center; }
  .gui-avatar-card {
    background: #161f2e; border: 2px solid #384252; border-radius: 8px;
    padding: 0.9rem; box-shadow: 5px 5px 0 0 #000000; text-align: center; width: 100%; max-width: 280px;
  }
  .gui-avatar-img {
    width: 100%; height: 240px; object-fit: cover;
    border: 2px solid #2d3748; border-radius: 6px; margin-bottom: 0.8rem;
  }
  .gui-avatar-caption strong { display: block; font-family: var(--font-heading); font-size: 0.95rem; font-weight: 800; color: #ffffff; }
  .gui-avatar-caption span { font-size: 0.75rem; font-family: var(--font-mono); color: #94a3b8; }

  /* Neubrutalism Cards Grid */
  .gui-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .nb-card {
    border: 2px solid #2d3748; border-radius: 8px; padding: 1.5rem;
    box-shadow: 4px 4px 0 0 #000000; transition: transform 0.15s, box-shadow 0.15s;
    background: #131924;
  }
  .nb-card:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 0 #000000; border-color: #3b4252; }
  .nb-card-yellow { border-top: 4px solid #f59e0b; }
  .nb-card-lavender { border-top: 4px solid #a855f7; }
  .nb-card-sky { border-top: 4px solid #38bdf8; }
  .nb-card-coral { border-top: 4px solid #ef4444; }

  .nb-card-header {
    display: flex; justify-content: space-between; align-items: center;
    border-bottom: 1px solid #2d3748; padding-bottom: 0.7rem; margin-bottom: 1.1rem;
  }
  .nb-card-header h2 { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 800; color: #ffffff; }
  .nb-card-tag {
    background: #1e293b; color: #38bdf8; border: 1px solid #334155;
    padding: 0.15rem 0.55rem; font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; border-radius: 4px;
  }

  .gui-info-list { display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.88rem; }
  .gui-info-item { display: flex; flex-direction: column; }
  .info-label { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 2px; }
  .info-val { font-weight: 700; color: #f8fafc; font-size: 0.92rem; }

  .gui-skills-container { display: flex; flex-direction: column; gap: 1.1rem; }
  .gui-skill-meta { display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 700; margin-bottom: 0.35rem; color: #f1f5f9; }
  .gui-progress-bar {
    background: #0d1117; border: 1px solid #30363d; border-radius: 4px;
    height: 18px; box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }
  .gui-progress-fill { height: 100%; }
  .gui-progress-fill.coral { background: linear-gradient(90deg, #ef4444, #f87171); }
  .gui-progress-fill.sky { background: linear-gradient(90deg, #0284c7, #38bdf8); }
  .gui-progress-fill.yellow { background: linear-gradient(90deg, #d97706, #fbbf24); }

  .gui-asset-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .gui-asset-link {
    display: flex; align-items: center; gap: 0.85rem;
    background: #161f2e; border: 1px solid #2d3748; border-radius: 6px;
    padding: 0.75rem 1rem; text-decoration: none; color: #f8fafc;
    box-shadow: 3px 3px 0 0 #000000; transition: all 0.15s;
  }
  .gui-asset-link:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 0 #000000; border-color: #38bdf8; background: #1c2738; }
  .asset-icon { font-size: 1.5rem; color: #38bdf8 !important; }
  .asset-details { flex: 1; display: flex; flex-direction: column; }
  .asset-details strong { font-size: 0.88rem; font-weight: 800; color: #ffffff; }
  .asset-details small { font-size: 0.72rem; color: #94a3b8; }
  .nb-mini-btn {
    background: #38bdf8; color: #000000;
    padding: 0.25rem 0.6rem; font-family: var(--font-mono); font-size: 0.68rem; font-weight: 800; border-radius: 4px;
  }

  .gui-link-grid { display: flex; flex-direction: column; gap: 0.75rem; }
  .gui-social-btn {
    display: flex; align-items: center; gap: 0.85rem;
    background: #161f2e; border: 1px solid #2d3748; border-radius: 6px;
    padding: 0.85rem 1.1rem; text-decoration: none; color: #ffffff; font-family: var(--font-heading);
    font-weight: 800; font-size: 0.92rem; box-shadow: 3px 3px 0 0 #000000; transition: all 0.15s;
  }
  .gui-social-btn:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 0 #000000; border-color: #f59e0b; background: #1c2738; }

  @media (max-width: 768px) {
    .gui-hero { grid-template-columns: 1fr; padding: 1.2rem; }
    .gui-grid { grid-template-columns: 1fr; gap: 1rem; }
    .gui-hero-title { font-size: 1.6rem; }
    .gui-header { flex-direction: column; align-items: flex-start; }
    .gui-nav-actions { width: 100%; justify-content: space-between; }
