    </div>
  </div>
</div>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&family=JetBrains+Mono:wght@400;500;600;700&family=Fira+Code:wght@400;500;600;700&display=swap');

  :root {
    /* Terminal colors (cyberpunk) */
    --bg: #0d0215;
    --bg-card: #110422;
    --text-primary: #e0d8ff;
    --text-dim: #7a6aa1;
    --text-dimmer: #4b3d65;
    --accent-cyan: #00f0ff;
    --accent-pink: #ff2e95;
    --accent-purple: #8a2be2;
    --accent-gold: #ffd700;
    --border: #2d1a42;
    --border-bright: #5a3a8a;
    --glow-cyan: 0 0 8px var(--accent-cyan), 0 0 20px var(--accent-cyan);
    --glow-pink: 0 0 8px var(--accent-pink), 0 0 20px var(--accent-pink);
    --glow-purple: 0 0 6px var(--accent-purple), 0 0 16px var(--accent-purple);

    /* Neubrutalism tokens (from neubrutalism.com) */
    --nb-black: #000000;
    --nb-white: #FFFDF5;
    --nb-yellow: #FFD23F;
    --nb-coral: #FF6B6B;
    --nb-sky: #74B9FF;
    --nb-green: #88D498;
    --nb-orange: #FFA552;
    --nb-lavender: #B8A9FA;

    --nb-stroke: 3px;
    --nb-radius: 0;
    --nb-shadow-sm: 3px 3px 0 0 var(--nb-black);
    --nb-shadow-md: 5px 5px 0 0 var(--nb-black);
    --nb-shadow-lg: 8px 8px 0 0 var(--nb-black);

    /* Fonts */
    --font-display: 'Syne', 'Space Grotesk', sans-serif;
    --font-heading: 'Space Grotesk', 'Syne', sans-serif;
    --font-body: 'Inter', 'Space Mono', monospace;
    --font-mono: 'Space Mono', 'JetBrains Mono', monospace;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: radial-gradient(ellipse at top, #140225 0%, var(--bg) 100%);
    min-height: 100vh;
    font-family: var(--font-body);
    overflow-x: hidden;
    color: var(--text-primary);
    line-height: 1.6;
  }

  /* ============================================================
     TERMINAL MODE (default)
     ============================================================ */

  .terminal-root {
    position: relative;
    width: 100%;
    max-width: 900px;
    min-height: 520px;
    margin: 2rem auto;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow:
      0 0 1px var(--border-bright),
      0 0 6px var(--border-bright),
      inset 0 0 30px rgba(138, 43, 226, 0.08);
    overflow: hidden;
    backdrop-filter: blur(4px);
  }

  .terminal-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(13, 2, 21, 0.15) 0px,
      rgba(13, 2, 21, 0.15) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
    z-index: 1;
  }

  .terminal-hud-glow {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 0%, rgba(0, 240, 255, 0.03) 50%, transparent 100%),
      linear-gradient(rgba(255, 46, 149, 0.04), transparent 80%);
    pointer-events: none;
    z-index: 0;
    opacity: 0.8;
  }

  /* Terminal Header with macOS-style controls */
  .terminal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1.2rem;
    background: rgba(13, 2, 21, 0.6);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(4px);
    z-index: 2;
    position: relative;
  }

  .terminal-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-cyan);
    letter-spacing: 1px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 8px var(--accent-cyan);
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.8; box-shadow: 0 0 4px var(--accent-cyan), 0 0 8px var(--accent-cyan); }
    50% { opacity: 1; box-shadow: 0 0 6px var(--accent-cyan), 0 0 12px var(--accent-cyan), 0 0 20px var(--accent-cyan); }
  }

  .dim { color: var(--text-dim); font-weight: 400; }

  .terminal-window-controls {
    display: flex;
    gap: 6px;
  }

  .control-btn {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .control-btn:nth-child(1) { background: #ff5f56; }
  .control-btn:nth-child(2) { background: #ffbd2e; }
  .control-btn:nth-child(3) { background: #27c93f; }

  /* Terminal body */
  .terminal-body {
    padding: 1.5rem 1.5rem 1rem;
    min-height: 380px;
    font-size: 0.82rem;
    line-height: 1.5;
    z-index: 2;
    position: relative;
    overflow-y: auto;
  }

  .terminal-body::-webkit-scrollbar { width: 6px; }
  .terminal-body::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.2); }
  .terminal-body::-webkit-scrollbar-thumb { background: var(--accent-purple); border-radius: 3px; }

  /* Output lines */
  .line {
    margin-bottom: 0.2rem;
    opacity: 0;
    transform: translateY(8px);
    animation: fadeInUp 0.3s forwards;
  }

  @keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }

  .line-delay-0 { animation-delay: 0ms; }
  .line-delay-1 { animation-delay: 80ms; }
  .line-delay-2 { animation-delay: 160ms; }
  .line-delay-3 { animation-delay: 240ms; }
  .line-delay-4 { animation-delay: 320ms; }
  .line-delay-5 { animation-delay: 400ms; }
  .line-delay-6 { animation-delay: 480ms; }
  .line-delay-7 { animation-delay: 560ms; }
  .line-delay-8 { animation-delay: 640ms; }
  .line-delay-9 { animation-delay: 720ms; }
  .line-delay-10 { animation-delay: 800ms; }
  .line-delay-11 { animation-delay: 880ms; }
  .line-delay-12 { animation-delay: 960ms; }
  .line-delay-13 { animation-delay: 1040ms; }
  .line-delay-14 { animation-delay: 1120ms; }
  .line-delay-15 { animation-delay: 1200ms; }

  .tag {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-right: 0.4rem;
  }
  .tag-sys { background: rgba(0, 240, 255, 0.15); color: var(--accent-cyan); border: 1px solid rgba(0, 240, 255, 0.3); }
  .tag-prof { background: rgba(255, 46, 149, 0.15); color: var(--accent-pink); border: 1px solid rgba(255, 46, 149, 0.3); }
  .tag-asset { background: rgba(138, 43, 226, 0.15); color: var(--accent-purple); border: 1px solid rgba(138, 43, 226, 0.3); }
  .tag-ok { background: rgba(39, 201, 63, 0.15); color: #27c93f; border: 1px solid rgba(39, 201, 63, 0.3); }
  .tag-warn { background: rgba(255, 189, 46, 0.15); color: #ffbd2e; border: 1px solid rgba(255, 189, 46, 0.3); }

  .highlight { color: var(--accent-cyan); }
  .highlight-cyan { color: var(--accent-cyan); }
  .highlight-pink { color: var(--accent-pink); }
  .highlight-purple { color: var(--accent-purple); }
  .highlight-gold { color: var(--accent-gold); }
  .success { color: #27c93f; }
  .warn { color: #ffbd2e; }
  .dim { color: var(--text-dim); }
  .makan { color: var(--accent-pink); }

  .divider {
    color: var(--border-bright);
    text-align: center;
    margin: 0.6rem 0;
    letter-spacing: 2px;
  }

  .ascii-box {
    border: 1px solid var(--border-bright);
    border-radius: 4px;
    padding: 0.1px;
    margin: 0.5rem 0;
    font-size: 0.78rem;
    background: rgba(13, 2, 21, 0.3);
  }
  .ascii-box-inner {
    border: 1px solid var(--border-bright);
    border-radius: 3px;
    padding: 0.6rem 0.8rem;
    background: rgba(0, 0, 0, 0.25);
  }
  .ascii-box-title {
    background: var(--border-bright);
    color: var(--bg);
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1px;
    border-radius: 2px;
    margin-bottom: 0.4rem;
  }

  .skill-bar { margin: 0.3rem 0; }
  .skill-name {
    display: flex; justify-content: space-between;
    margin-bottom: 0.15rem; font-size: 0.78rem;
  }
  .skill-name span { color: var(--accent-cyan); }
  .skill-name .level-label { color: var(--text-dim); }
  .skill-track {
    height: 8px; background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border); border-radius: 4px; overflow: hidden; position: relative;
  }
  .skill-fill {
    height: 100%; border-radius: 3px;
    transition: width 0.8s ease, background-color 0.3s;
    display: flex; align-items: center; justify-content: flex-end; padding-right: 4px;
  }
  .skill-fill .bar-text {
    font-size: 0.68rem; font-weight: 700; color: var(--bg);
    text-shadow: 0 0 3px rgba(0, 0, 0, 0.7);
  }

  .asset-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.4rem; margin: 0.5rem 0;
  }
  .asset-item {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.3rem 0.5rem; border-radius: 4px;
    background: rgba(0, 0, 0, 0.2); border: 1px solid var(--border);
    font-size: 0.72rem; transition: all 0.2s;
  }
  .asset-item:hover {
    background: rgba(138, 43, 226, 0.1); border-color: var(--accent-purple);
    transform: translateX(2px);
  }
  .asset-icon { font-size: 1.1rem; }
  .asset-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-primary); }
  .asset-size { color: var(--text-dim); font-size: 0.65rem; }

  .link-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.4rem; margin: 0.5rem 0;
  }
  .link-item {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.4rem 0.5rem; border-radius: 4px;
    background: rgba(0, 0, 0, 0.2); border: 1px solid var(--border);
    font-size: 0.8rem; transition: all 0.2s; text-decoration: none;
  }
  .link-item:hover {
    background: rgba(0, 240, 255, 0.08); border-color: var(--accent-cyan);
    transform: translateX(2px);
  }
  .link-item .link-icon { font-size: 1.2rem; min-width: 24px; text-align: center; }
