  function fmtTime() {
    const d = new Date();
    const pad = (n) => n.toString().padStart(2, '0');
    return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
  }

  function createLine(text, cls, delayIdx) {
    const spans = document.createElement('div');
    spans.className = 'line line-delay-' + delayIdx;
    if (cls) {
      const tagMatch = cls.match(/^tag-/);
      if (tagMatch) {
        const tag = document.createElement('span');
        tag.className = cls;
        const nameMap = {
          'tag-sys': '[SYS_INFO]',
          'tag-prof': '[USER_PROFILE]',
          'tag-asset': '[ASTRO_ASSETS]',
          'tag-ok': '[OK]',
          'tag-warn': '[WARN]',
        };
        tag.textContent = nameMap[cls] || '[' + cls + ']';
        spans.appendChild(tag);
      } else {
        spans.classList.add(cls);
      }
    }
    if (text) { spans.innerHTML += text; }
    return spans;
  }

  function runBootSequence() {
    const body = document.getElementById('terminal-body');
    body.innerHTML = '';
    let idx = 0; let lineIndex = 0;
    function nextLine() {
      if (idx >= bootSequence.length) { addPrompt(); return; }
      const entry = bootSequence[idx]; idx++;
      if (entry.skip) { setTimeout(nextLine, entry.delay || 100); return; }
      const lineEl = createLine(entry.text, entry.cls, Math.min(lineIndex, 15));
      body.appendChild(lineEl); lineIndex++;
      body.scrollTop = body.scrollHeight;
      setTimeout(nextLine, entry.delay || 300);
    }
    nextLine();
  }

  function addPrompt() {
    const body = document.getElementById('terminal-body');
    const prompt = document.createElement('div');
    prompt.className = 'line';
    prompt.innerHTML = '<span class="dim">[' + fmtTime() + ']</span> <span class="input-prompt">fajri$</span> <span class="dim">Ketik [1] SKILLS | [2] ASSETS/LICENSE | [3] LINKS | [4] PROFILE</span>';
    body.appendChild(prompt);
    body.scrollTop = body.scrollHeight;
  }

  function outputLine(text, cls) {
    const body = document.getElementById('terminal-body');
    const lineIndex = body.children.length;
    const lineEl = createLine(text, cls, 0);
    lineEl.style.animationDelay = '0ms';
    body.appendChild(lineEl);
    body.scrollTop = body.scrollHeight;
  }

  function outputDivider() {
    const body = document.getElementById('terminal-body');
    const div = document.createElement('div');
    div.className = 'divider';
    div.textContent = '----------------------------------------';
    body.appendChild(div);
    body.scrollTop = body.scrollHeight;
  }

  function clearOutput() {
    const body = document.getElementById('terminal-body');
    body.innerHTML = '';
    addPrompt();
  }

  function handleCommand(cmd) {
    const body = document.getElementById('terminal-body');
    const echo = document.createElement('div');
    echo.className = 'line';
    echo.innerHTML = '<span class="highlight-pink">fajri$</span> ' + escapeHtml(cmd);
    body.appendChild(echo);
    body.scrollTop = body.scrollHeight;

    const c = cmd.trim().toLowerCase();

    if (c === '' || c === 'help' || c === 'h' || c === '?') { showHelp(); }
    else if (c === '1' || c === 'skills' || c === 'skill') { showSkills(); }
    else if (c === '2' || c === 'assets' || c === 'license' || c === 'cert') { showAssets(); }
    else if (c === '3' || c === 'links' || c === 'social' || c === 'connect') { showLinks(); }
    else if (c === '4' || c === 'profile' || c === 'about' || c === 'whoami') { showProfile(); }
    else if (c === 'makan' || c === 'hobby' || c === 'eat') { showMakan(); }
    else if (c === '4321' || c === 'port') { showPortStatus(); }
    else if (c === 'clear' || c === 'cls') { clearOutput(); return; }
    else {
      outputLine('[ERROR] Unknown command: <span class="highlight-pink">' + escapeHtml(cmd) + '</span>', 'tag-warn');
      outputLine('<span class="dim">Available: [1] SKILLS, [2] ASSETS, [3] LINKS, [4] PROFILE, [help], [makan], [clear]</span>', 'dim');
    }
    addPrompt();
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function showHelp() {
