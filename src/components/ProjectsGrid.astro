---
import LanguageBadge from './LanguageBadge.astro';

interface GitHubRepo {
  id: number;
  name: string;
  full_name: string;
  description: string | null;
  html_url: string;
  homepage: string | null;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
  fork: boolean;
  updated_at: string;
  topics?: string[];
}

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN || '';
const GITHUB_USERNAME = import.meta.env.GITHUB_USERNAME || process.env.GITHUB_USERNAME || 'LazenFajri';

let repos: GitHubRepo[] = [];
let fetchError: string | null = null;

try {
  const headers: Record<string, string> = {
    'Accept': 'application/vnd.github.v3+json',
    'User-Agent': 'Portfolio-Astro-App',
  };

  if (GITHUB_TOKEN) {
    headers['Authorization'] = `Bearer ${GITHUB_TOKEN}`;
  }

  // Fetch repositories sorted by most recently updated
  const url = `https://api.github.com/users/${GITHUB_USERNAME}/repos?per_page=30&sort=updated`;
  const response = await fetch(url, { headers });

  if (!response.ok) {
    throw new Error(`GitHub API error: ${response.status} ${response.statusText}`);
  }

  const allRepos = (await response.json()) as GitHubRepo[];
  // Filter out forks if desired, or keep original work first
  repos = allRepos.filter(r => !r.fork);
  if (repos.length === 0 && allRepos.length > 0) {
    repos = allRepos;
  }
} catch (error: any) {
  fetchError = error?.message || 'Failed to fetch GitHub repositories';
  console.warn('[ProjectsGrid] Notice:', fetchError);
}
---

<section id="projects" class="w-full max-w-6xl mx-auto py-12 px-4 sm:px-6">
  <!-- Header with antigravity minimalist typography and clean negative space -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-5 border-b border-slate-800/80 gap-4">
    <div class="space-y-1.5">
      <div class="inline-flex items-center gap-2 text-xs font-mono tracking-wider text-cyan-400/90 uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>Verified Repositories</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-100 font-mono">
        OPEN SOURCE & PROJECTS
      </h2>
      <p class="text-sm text-slate-400 font-sans max-w-xl">
        Automated build-time synchronization via GitHub REST API with dynamic language & stack detection.
      </p>
    </div>

    <div class="flex items-center gap-4 text-xs font-mono text-slate-500">
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500/80"></span>
        Live Build
      </span>
      <span>•</span>
      <a
        href={`https://github.com/${GITHUB_USERNAME}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-400 hover:text-cyan-400 transition-colors flex items-center gap-1"
      >
        @{GITHUB_USERNAME}
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
        </svg>
      </a>
    </div>
  </div>

  {fetchError && (
    <div class="p-4 rounded-lg bg-red-950/20 border border-red-900/40 text-red-300 text-xs font-mono mb-6 flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
      <span>Notice: {fetchError}. Rendering cached or fallback repository structure.</span>
    </div>
  )}

  <!-- Clean antigravity grid layout: subtle slate tones, zero unnecessary borders, crisp hover elevation -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
    {repos.map((project) => (
      <article class="group relative flex flex-col justify-between p-5 rounded-xl bg-slate-900/40 hover:bg-slate-900/80 border border-slate-800/60 hover:border-slate-700/80 transition-all duration-300 backdrop-blur-sm">
        <div class="space-y-3">
          <!-- Top Row: Name and Outbound Link -->
          <div class="flex items-start justify-between gap-2">
            <h3 class="font-mono text-base font-semibold text-slate-100 group-hover:text-cyan-300 transition-colors truncate">
              <a
                href={project.html_url}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:underline flex items-center gap-1.5"
              >
                <span>{project.name}</span>
              </a>
            </h3>

            <div class="flex items-center gap-2 opacity-60 group-hover:opacity-100 transition-opacity">
              {project.homepage && (
                <a
                  href={project.homepage}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Live Demo"
                  class="p-1 rounded text-slate-400 hover:text-white hover:bg-slate-800 transition-all"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                  </svg>
                </a>
              )}
              <a
                href={project.html_url}
                target="_blank"
                rel="noopener noreferrer"
                title="View Source on GitHub"
                class="p-1 rounded text-slate-400 hover:text-white hover:bg-slate-800 transition-all"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Description -->
          <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed min-h-[2rem]">
            {project.description || 'No description provided for this repository.'}
          </p>
        </div>

        <!-- Bottom Footer: Language Badge & Meta -->
        <div class="mt-5 pt-3.5 border-t border-slate-800/40 flex items-center justify-between gap-3">
          <!-- Dynamic Primary Tech Stack Badge mapped via project.language -->
          <LanguageBadge language={project.language} />

          <!-- Subtle Repo Stats -->
          <div class="flex items-center gap-3 text-[11px] font-mono text-slate-500">
            {project.stargazers_count > 0 && (
              <span class="flex items-center gap-1">
                <svg class="w-3 h-3 text-amber-400/80" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                </svg>
                {project.stargazers_count}
              </span>
            )}
            {project.forks_count > 0 && (
              <span class="flex items-center gap-1">
                <svg class="w-3 h-3 text-slate-500" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M6 2a3 3 0 0 0-3 3c0 1.3.84 2.4 2 2.82V14.18C3.84 14.6 3 15.7 3 17a3 3 0 0 0 6 0c0-1.3-.84-2.4-2-2.82V11c0-.55.45-1 1-1h8c.55 0 1 .45 1 1v3.18c-1.16.42-2 1.52-2 2.82a3 3 0 0 0 6 0c0-1.3-.84-2.4-2-2.82V7.82c1.16-.42 2-1.52 2-2.82a3 3 0 0 0-6 0c0 1.3.84 2.4 2 2.82V9H8V7.82C9.16 7.4 10 6.3 10 5a3 3 0 0 0-3-3H6z"/>
                </svg>
                {project.forks_count}
              </span>
            )}
            <span class="text-slate-600 truncate max-w-[80px]">
              {new Date(project.updated_at).toLocaleDateString(undefined, { month: 'short', year: '2-digit' })}
            </span>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
